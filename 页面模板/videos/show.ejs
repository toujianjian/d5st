<style>
  .p-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 20px 70px; }
  .crumbs { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--primary); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .p-layout { display: grid; grid-template-columns: 1fr 320px; gap: 20px; align-items: start; }
  @media (max-width: 900px) { .p-layout { grid-template-columns: 1fr; } }

  .player-box {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-soft);
  }
  .player { width: 100%; aspect-ratio: 16/9; background: #000; display: block; }
  .player-box .ph {
    width: 100%; aspect-ratio: 16/9; background: linear-gradient(135deg,#d32f2f,#ff6b35);
    display: flex; align-items: center; justify-content: center; color: #fff; font-size: 56px;
  }
  .p-info { padding: 20px 22px 22px; }
  .p-title { font-size: 20px; font-weight: 700; color: var(--text-dark); line-height: 1.4; margin-bottom: 10px; }
  .p-meta { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; }
  .p-meta .av {
    width: 34px; height: 34px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700;
  }
  .p-desc { margin-top: 14px; font-size: 14px; line-height: 1.8; color: var(--text-light); white-space: pre-wrap; }
  .p-link { margin-top: 12px; font-size: 13px; }
  .p-link a { color: var(--primary); }

  .side-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 20px; padding: 18px; box-shadow: var(--shadow-soft);
  }
  .side-title { font-size: 14px; font-weight: 700; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; }
  .side-title i { color: var(--primary); }
  .rel-item { display: flex; gap: 10px; padding: 8px 0; text-decoration: none; color: inherit; }
  .rel-thumb {
    width: 110px; height: 64px; border-radius: 10px; flex-shrink: 0; object-fit: cover;
    background: linear-gradient(135deg,#ffe4e4,#ffd0d0);
    display: flex; align-items: center; justify-content: center; font-size: 20px;
  }
  .rel-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 10px; }
  .rel-body { flex: 1; min-width: 0; }
  .rel-name {
    font-size: 13px; font-weight: 600; color: var(--text-dark); line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .rel-meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
</style>

<div class="p-wrap">
  <div class="crumbs">
    <a href="/videos">视频</a>
    › <a href="/videos?category=<%= video.category %>"><%= video.category_icon %> <%= video.category_label %></a>
    › <%= video.title %>
  </div>

  <div class="p-layout">
    <div>
      <div class="player-box">
        <% var isFile = /\.(mp4|webm|ogg|mov)(\?|$)/i.test(video.video_url); %>
        <% if (isFile) { %>
        <video class="player" controls preload="metadata" poster="<%= video.cover_url || '' %>">
          <source src="<%= video.video_url %>" />
          您的浏览器不支持视频播放
        </video>
        <% } else { %>
        <a class="ph" href="<%= video.video_url %>" target="_blank" rel="noopener" title="打开视频链接">▶</a>
        <% } %>
        <div class="p-info">
          <h1 class="p-title"><%= video.title %></h1>
          <div class="p-meta">
            <div class="av"><%= video.author.charAt(0) %></div>
            <span><%= video.author %></span>
            <span><i class="far fa-eye"></i> <%= video.views || 0 %> 次播放</span>
            <span><i class="far fa-clock"></i> <%= fmtDate(video.created_at, false) %></span>
            <span><i class="fas fa-folder"></i> <%= video.category_label %></span>
          </div>
          <% if (video.description) { %>
          <div class="p-desc"><%= video.description %></div>
          <% } %>
          <div class="p-link"><a href="<%= video.video_url %>" target="_blank" rel="noopener"><i class="fas fa-external-link-alt"></i> 打开原始视频地址</a></div>
        </div>
      </div>
    </div>

    <div class="side-card">
      <div class="side-title"><i class="fas fa-list"></i> 相关推荐</div>
      <% if (related && related.length > 0) { %>
      <% related.forEach(function(r) { %>
      <a class="rel-item" href="/videos/<%= r.id %>">
        <div class="rel-thumb">
          <% if (r.cover_url) { %>
          <img src="<%= r.cover_url %>" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
          <% } else { %>🎬<% } %>
        </div>
        <div class="rel-body">
          <div class="rel-name"><%= r.title %></div>
          <div class="rel-meta"><i class="far fa-eye"></i> <%= r.views || 0 %> · <%= fmtDate(r.created_at, false) %></div>
        </div>
      </a>
      <% }); %>
      <% } else { %>
      <div style="text-align:center;padding:26px;color:var(--text-muted);font-size:13px;">暂无相关视频</div>
      <% } %>
    </div>
  </div>
</div>
