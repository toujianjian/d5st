<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">➕ 新增首页链接</div>
      <form method="POST" action="/admin/home-links">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 80px;gap:12px;">
          <input type="text" name="title" class="form-input" placeholder="标题" required>
          <input type="text" name="url" class="form-input" placeholder="链接（可填 /forum 等站内相对路径，或 https://...）" required>
          <input type="text" name="icon" class="form-input" placeholder="Emoji 图标">
          <input type="number" name="sort_order" class="form-input" placeholder="排序">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:12px;">添加</button>
      </form>
    </div>
    <div class="card">
      <div class="card-title">📋 现有链接</div>
      <table class="table">
        <thead><tr><th>ID</th><th>图标</th><th>标题</th><th>链接</th><th>排序</th><th>操作</th></tr></thead>
        <tbody>
          <% links.forEach(function(l) { %>
            <tr>
              <td><%= l.id %></td><td><%= l.icon || '🔗' %></td><td><%= l.title %></td><td><a href="<%= l.url %>" target="_blank"><%= l.url %></a></td><td><%= l.sort_order %></td>
              <td><form method="POST" action="/admin/home-links/delete/<%= l.id %>" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger btn-sm">删除</button></form></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
