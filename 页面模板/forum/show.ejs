<style>
  .show-wrap { max-width: 860px; margin: 0 auto; padding: 24px 20px 80px; }
  .crumbs { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
  .crumbs a { color: var(--primary); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .post-box {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 20px; padding: 26px; box-shadow: var(--shadow-soft); margin-bottom: 18px;
  }
  .post-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .badge { font-size: 11px; padding: 3px 9px; border-radius: 8px; font-weight: 600; }
  .badge-top { background: linear-gradient(135deg,#ff6b35,#d32f2f); color: #fff; }
  .badge-essence { background: linear-gradient(135deg,#ffd700,#ff9800); color: #6b4e00; }
  .badge-type { background: rgba(211,47,47,.1); color: var(--primary); }
  .post-title { font-size: 24px; font-weight: 700; color: var(--text-dark); line-height: 1.4; margin-bottom: 12px; }
  .post-info { display: flex; align-items: center; gap: 14px; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; padding-bottom: 16px; border-bottom: 1px solid rgba(0,0,0,.06); }
  .post-info .av {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700;
  }
  .post-cover-img { width: 100%; max-height: 320px; object-fit: cover; border-radius: 14px; margin: 16px 0; }
  .post-content { font-size: 15px; line-height: 1.9; color: var(--text-dark); white-space: pre-wrap; margin-top: 14px; }
  .post-tags { margin-top: 16px; }
  .post-tag {
    display: inline-block; padding: 4px 10px; margin-right: 6px; border-radius: 10px;
    background: rgba(211,47,47,.08); color: var(--primary); font-size: 12px; text-decoration: none;
  }
  .post-actions { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .act-btn {
    padding: 10px 18px; border-radius: 12px; border: 1px solid rgba(211,47,47,.2);
    background: rgba(255,255,255,.7); color: var(--text-light); cursor: pointer;
    font-size: 14px; display: flex; align-items: center; gap: 6px; transition: all .25s;
  }
  .act-btn:hover { border-color: var(--primary); color: var(--primary); }
  .act-btn.liked { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; border-color: transparent; }

  .comment-box {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 20px; padding: 24px; box-shadow: var(--shadow-soft);
  }
  .comment-title { font-size: 16px; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .comment-title i { color: var(--primary); }
  .comment-item { display: flex; gap: 12px; padding: 14px 0; border-bottom: 1px solid rgba(0,0,0,.05); }
  .comment-item:last-child { border-bottom: none; }
  .comment-av {
    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 15px;
  }
  .comment-body { flex: 1; min-width: 0; }
  .comment-meta { font-size: 12px; color: var(--text-muted); margin-bottom: 5px; display: flex; gap: 10px; }
  .comment-meta .nm { font-weight: 600; color: var(--text-dark); font-size: 13px; }
  .comment-text { font-size: 14px; line-height: 1.7; color: var(--text-dark); white-space: pre-wrap; }
  .comment-replies { margin-top: 10px; padding-left: 14px; border-left: 2px solid rgba(211,47,47,.15); }
  .reply-btn { font-size: 12px; color: var(--text-muted); cursor: pointer; margin-top: 6px; background: none; border: none; padding: 0; }
  .reply-btn:hover { color: var(--primary); }

  .comment-form { margin-top: 18px; }
  .comment-form textarea {
    width: 100%; min-height: 90px; padding: 14px; border-radius: 14px;
    border: 1px solid rgba(211,47,47,.2); background: rgba(255,255,255,.75);
    font-family: inherit; font-size: 14px; resize: vertical; color: var(--text-dark);
  }
  .comment-form textarea:focus { outline: none; border-color: var(--primary); }
  .submit-btn {
    margin-top: 10px; padding: 11px 24px; border: none; border-radius: 12px; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff;
    font-size: 14px; font-weight: 600; transition: all .25s;
  }
  .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(211,47,47,.35); }

  .nav-posts { display: flex; justify-content: space-between; gap: 12px; margin-top: 18px; flex-wrap: wrap; }
  .nav-posts a {
    flex: 1; min-width: 200px; padding: 12px 16px; border-radius: 14px; font-size: 13px;
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    color: var(--text-light); text-decoration: none; transition: all .25s;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .nav-posts a:hover { border-color: var(--primary); color: var(--primary); }
</style>

<div class="show-wrap">
  <div class="crumbs">
    <a href="/forum">校园贴吧</a>
    <% if (post.board_name) { %> › <a href="/forum?board=<%= post.board_slug %>"><%= post.board_name %></a><% } %>
    › 正文
  </div>

  <div class="post-box">
    <div class="post-head">
      <% if (post.is_top) { %><span class="badge badge-top">置顶</span><% } %>
      <% if (post.is_hot) { %><span class="badge badge-essence">精华</span><% } %>
      <span class="badge badge-type"><%= post.type_icon %> <%= post.type_label %></span>
      <% if (post.category_label) { %><span class="badge badge-type"><%= post.category_label %></span><% } %>
    </div>
    <h1 class="post-title"><%= post.title %></h1>
    <div class="post-info">
      <div class="av"><%= post.author.charAt(0) %></div>
      <span><%= post.author %></span>
      <span><i class="far fa-clock"></i> <%= fmtDate(post.created_at) %></span>
      <span><i class="far fa-eye"></i> <%= post.views || 0 %> 浏览</span>
      <span><i class="far fa-comment"></i> <%= (post.comments || []).length %> 评论</span>
    </div>

    <% if (post.cover_image) { %>
    <img class="post-cover-img" src="<%= post.cover_image %>" alt="" onerror="this.style.display='none'" />
    <% } %>

    <div class="post-content"><%= post.content %></div>

    <% if (structuredTags && structuredTags.length > 0) { %>
    <div class="post-tags">
      <% structuredTags.forEach(function(t) { %>
      <a class="post-tag" href="/forum?tag=<%= encodeURIComponent(t) %>">#<%= t %></a>
      <% }); %>
    </div>
    <% } %>

    <div class="post-actions">
      <button class="act-btn <%= post.liked ? 'liked' : '' %>" id="likeBtn">
        <i class="fas fa-heart"></i> <span id="likeCount"><%= post.likes %></span>
      </button>
      <button class="act-btn" onclick="document.getElementById('commentInput').focus()">
        <i class="far fa-comment"></i> 评论
      </button>
    </div>
  </div>

  <div class="comment-box">
    <div class="comment-title"><i class="fas fa-comments"></i> 评论</div>

    <% if (post.comments && post.comments.length > 0) { %>
    <% post.comments.forEach(function(c) { %>
    <div class="comment-item">
      <div class="comment-av"><%= c.author.charAt(0) %></div>
      <div class="comment-body">
        <div class="comment-meta">
          <span class="nm"><%= c.author %></span>
          <span><%= fmtDate(c.created_at) %></span>
        </div>
        <div class="comment-text"><%= c.content %></div>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <button class="reply-btn" onclick="replyTo('<%= c.id %>')">回复</button>
        <% } %>
        <% if (c.replies && c.replies.length > 0) { %>
        <div class="comment-replies">
          <% c.replies.forEach(function(r) { %>
          <div class="comment-item" style="border-bottom:none;padding:8px 0;">
            <div class="comment-av" style="width:28px;height:28px;font-size:12px;"><%= r.author.charAt(0) %></div>
            <div class="comment-body">
              <div class="comment-meta">
                <span class="nm"><%= r.author %></span>
                <span><%= fmtDate(r.created_at) %></span>
              </div>
              <div class="comment-text"><%= r.content %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </div>
    </div>
    <% }); %>
    <% } else { %>
    <div style="text-align:center;padding:30px;color:var(--text-muted);">
      <i class="far fa-comment-dots" style="font-size:32px;opacity:.4;"></i>
      <p style="margin-top:8px;">还没有评论，来说两句吧</p>
    </div>
    <% } %>

    <div class="comment-form">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <textarea id="commentInput" placeholder="写下你的评论…"></textarea>
      <input type="hidden" id="parentId" value="" />
      <button class="submit-btn" id="commentBtn">发表评论</button>
      <% } else { %>
      <div style="text-align:center;padding:20px;color:var(--text-muted);">
        <a href="/login" style="color:var(--primary);">登录后参与评论</a>
      </div>
      <% } %>
    </div>
  </div>

  <div class="nav-posts">
    <% if (post.prev) { %><a href="/forum/<%= post.prev.id %>">‹ 上一篇：<%= post.prev.title %></a><% } else { %><span></span><% } %>
    <% if (post.next) { %><a href="/forum/<%= post.next.id %>" style="text-align:right;">下一篇：<%= post.next.title %> ›</a><% } %>
  </div>
</div>

<script>
  var POST_ID = '<%= post.id %>';
  var likeBtn = document.getElementById('likeBtn');
  if (likeBtn) {
    likeBtn.addEventListener('click', async function () {
      try {
        var r = await fetch('/forum/like/' + POST_ID, { method: 'POST' });
        if (r.status === 401) { alert('请先登录'); return; }
        var d = await r.json();
        if (d.error) { alert(d.error); return; }
        var cnt = document.getElementById('likeCount');
        cnt.textContent = parseInt(cnt.textContent, 10) + (d.liked ? 1 : -1);
        likeBtn.classList.toggle('liked', d.liked);
      } catch (e) { alert('操作失败'); }
    });
  }

  function replyTo(id) {
    document.getElementById('parentId').value = id;
    var input = document.getElementById('commentInput');
    input.focus();
    input.placeholder = '回复该评论…';
  }

  var commentBtn = document.getElementById('commentBtn');
  if (commentBtn) {
    commentBtn.addEventListener('click', async function () {
      var input = document.getElementById('commentInput');
      var content = input.value.trim();
      if (!content) { alert('评论内容不能为空'); return; }
      var parentId = document.getElementById('parentId').value;
      try {
        var r = await fetch('/forum/comment/' + POST_ID, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content: content, parent_id: parentId || null })
        });
        var d = await r.json();
        if (d.success) { location.reload(); } else { alert(d.error || '评论失败'); }
      } catch (e) { alert('评论失败'); }
    });
  }
</script>
