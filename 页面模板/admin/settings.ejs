<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>📊 概览</h3><a href="/admin">仪表盘</a>
    <h3>📋 内容管理</h3><a href="/admin/forum">帖子管理</a>
    <a href="/admin/comments">评论管理</a><a href="/admin/reports">举报管理</a>
    <h3>🔔 通知与弹窗</h3><a href="/admin/notifications">全局通知</a><a href="/admin/popups">弹窗管理</a>
    <h3>🏠 首页设置</h3><a href="/admin/home-links">首页链接</a><a href="/admin/home-banners">首页横幅</a>
    <h3>🛠️ 系统</h3><a href="/admin/path-redirects">路径重定向</a><a href="/admin/recycle-bin">回收站</a><a href="/admin/export-users">导出用户</a><a href="/admin/settings">系统设置</a>
  </aside>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">⚙️ 系统设置</div>
      <form method="POST" action="/admin/settings">
        <% settings.forEach(function(s) { %>
          <div class="form-group">
            <label class="form-label"><%= s.setting_key %> <span style="color:var(--text-secondary);font-weight:normal;font-size:12px;"><%= s.description || '' %></span></label>
            <input type="text" name="<%= s.setting_key %>" class="form-input" value="<%= s.setting_value %>">
          </div>
        <% }); %>
        <button type="submit" class="btn btn-primary">保存设置</button>
      </form>
    </div>
  </div>
</div>
