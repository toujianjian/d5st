<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= typeof title !== 'undefined' && title ? title : 'D5ST 校园社区' %><% if (typeof siteTitle !== 'undefined' && title && title !== siteTitle) { %> - <%= siteTitle %><% } %></title>
    <meta name="description" content="D5ST 校园社区 - 连接每一位同学，共享校园生活" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>" />
    <link rel="stylesheet" href="/public/font-awesome/all.min.css" />
    <link rel="stylesheet" href="/public/css/pidanai-theme.css" />
    <link rel="stylesheet" href="/public/css/pidanai.css" />
    <link rel="stylesheet" href="/public/css/pidanai-home.css" />
    <script>
      /* 在样式表解析前同步设定主题，避免刷新先闪一下浅色再变深 */
      (function () {
        try {
          var t = localStorage.getItem("leo-theme");
          if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <style>
      html:not(.pdaim-cursor-ready) .cursor-reveal,
      html:not(.pdaim-cursor-ready) .cursor-pop {
        opacity: 0 !important;
        visibility: hidden !important;
      }
      .pdaim-fps {
        min-width: 58px;
        padding: 5px 9px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--bg) 12%, transparent);
        color: color-mix(in srgb, var(--fg) 74%, transparent);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 11px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: 0.02em;
        text-align: center;
        pointer-events: none;
        box-shadow:
          inset 0 0 0 1px color-mix(in srgb, var(--fg) 7%, transparent),
          0 4px 12px color-mix(in srgb, var(--pdaim-glass-shadow) 10%, transparent);
      }
      @media (max-width: 720px), (pointer: coarse) {
        .pdaim-fps { display: none !important; }
      }
      /* 移动端顶部汉堡按钮：保证三条横线可见（浅色背景下白色线条会看不清），
         并给出可点击的手型光标与最小触控尺寸。 */
      .mobile-menu-toggle {
        color: var(--fg) !important;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
      }
      .mobile-menu-toggle span {
        /* 按钮内容区仅 26px，而 3 条线各带 5px 上下外边距共需 36px，
           会被 flex 压缩成 0 高（线条看不见）。收紧外边距并禁止收缩。 */
        height: 2px !important;
        margin: 3px 0 !important;
        flex: 0 0 auto !important;
        background-color: currentColor !important;
      }

      /* 首页弹窗样式（layout-home 此前没有，导致弹窗无法显示） */
      .popup-overlay {
        position: fixed; inset: 0;
        background: rgba(0, 0, 0, 0.6);
        display: none; align-items: center; justify-content: center;
        z-index: 2000; backdrop-filter: blur(8px);
      }
      .popup-overlay.show { display: flex; }
      .popup-container {
        background: #fff; border-radius: 24px; padding: 32px;
        width: 90%; max-width: 500px; position: relative;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }
      .popup-close-btn {
        position: absolute; top: 16px; right: 16px;
        width: 36px; height: 36px; border: none;
        background: rgba(0, 0, 0, 0.05); border-radius: 50%;
        cursor: pointer; display: flex; align-items: center; justify-content: center;
        font-size: 16px; color: #999;
      }
      .popup-title { font-size: 22px; font-weight: 700; color: #2d2d2d; text-align: center; margin-bottom: 16px; }
      .popup-content { font-size: 15px; color: #666; line-height: 1.7; text-align: center; margin-bottom: 24px; }
      .popup-btn {
        display: block; width: 100%; padding: 14px 24px;
        border: none; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer;
        background: linear-gradient(135deg, #d32f2f, #b71c1c); color: #fff;
      }
    </style>
  </head>
  <body>
    <%- body %>

    <script>
      /* 首页弹窗支持：首页使用 layout-home，此前不含弹窗逻辑，
         导致后台配置的「首页弹窗」永远不会显示。这里补齐。 */
      (function () {
        function showPopup(popup) {
          var overlay = document.createElement('div');
          overlay.className = 'popup-overlay';
          var container = document.createElement('div');
          container.className = 'popup-container';
          var closeBtn = document.createElement('button');
          closeBtn.className = 'popup-close-btn';
          closeBtn.innerHTML = '<i class="fas fa-times"></i>';
          var close = function () {
            overlay.classList.remove('show');
            fetch('/api/popups/' + popup.id + '/close', { method: 'POST' }).catch(function () {});
            setTimeout(function () { if (overlay.parentNode) overlay.parentNode.removeChild(overlay); }, 300);
          };
          closeBtn.onclick = close;
          var title = document.createElement('h3');
          title.className = 'popup-title';
          title.textContent = popup.title || '';
          var content = document.createElement('div');
          content.className = 'popup-content';
          content.innerHTML = popup.content || '';
          var btn = document.createElement('button');
          btn.className = 'popup-btn';
          btn.textContent = '知道了';
          btn.onclick = close;
          container.appendChild(closeBtn);
          container.appendChild(title);
          container.appendChild(content);
          container.appendChild(btn);
          overlay.appendChild(container);
          document.body.appendChild(overlay);
          setTimeout(function () { overlay.classList.add('show'); }, 100);
        }
        async function loadPopups() {
          try {
            var res = await fetch('/api/popups?page=home');
            var popups = await res.json();
            popups.forEach(showPopup);
          } catch (e) { /* ignore */ }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', loadPopups);
        } else {
          loadPopups();
        }
      })();
    </script>

    <script src="/public/js/pidanai-liquid.js" defer></script>
    <script src="/public/js/home-shell.js" defer></script>
  </body>
</html>
