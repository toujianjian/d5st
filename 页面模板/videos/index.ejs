<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px; margin-top: 20px;
  }
  .video-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 18px; overflow: hidden;
    text-decoration: none; color: inherit;
    transition: all 0.3s ease; display: flex; flex-direction: column;
    box-shadow: var(--shadow-soft);
  }
  .video-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
  .video-thumb {
    aspect-ratio: 16/9;
    background: linear-gradient(135deg, #d32f2f, #b71c1c);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 48px;
    position: relative; overflow: hidden;
  }
  .video-thumb .play-icon {
    width: 60px; height: 60px; border-radius: 50%;
    background: rgba(255,255,255,0.25);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(10px);
  }
  .video-thumb .play-icon i { font-size: 22px; color: white; }
  .video-info { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; }
  .video-title { font-size: 15px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px; line-height: 1.4; }
  .video-meta { display: flex; gap: 12px; font-size: 12px; color: var(--text-light); margin-top: auto; }
  .video-meta span { display: inline-flex; align-items: center; gap: 4px; }
  .empty-videos { text-align: center; padding: 60px 20px; }
  .empty-videos i { font-size: 48px; color: var(--primary); margin-bottom: 16px; }
  .empty-videos h3 { font-family: 'Noto Serif SC', serif; }
  .toolbar { margin-bottom: 16px; }
  .category-tag {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 16px; border-radius: 999px;
    background: rgba(255,255,255,0.5); color: var(--text-dark);
    text-decoration: none; font-size: 13px; font-weight: 500;
    border: 1px solid rgba(0,0,0,0.06); margin-right: 8px; margin-bottom: 8px;
    transition: all 0.25s ease;
  }
  .category-tag.active, .category-tag:hover {
    background: var(--primary); color: white; border-color: var(--primary);
  }
</style>

<div class="page-container">
  <h2 style="font-family: 'Noto Serif SC', serif; color: var(--text-dark); margin: 20px 0 8px;">
    📸 校园风采
  </h2>
  <p style="color: var(--text-light); margin-bottom: 16px;">精彩校园视频展示</p>

  <div class="toolbar">
    <a href="/videos" class="category-tag <%= !activeCategory ? 'active' : '' %>"><i class="fas fa-globe"></i> 全部</a>
    <a href="/videos?category=campus" class="category-tag <%= activeCategory==='campus' ? 'active' : '' %>"><i class="fas fa-school"></i> 校园</a>
    <a href="/videos?category=sport" class="category-tag <%= activeCategory==='sport' ? 'active' : '' %>"><i class="fas fa-futbol"></i> 运动</a>
    <a href="/videos?category=event" class="category-tag <%= activeCategory==='event' ? 'active' : '' %>"><i class="fas fa-star"></i> 活动</a>
    <a href="/videos?category=other" class="category-tag <%= activeCategory==='other' ? 'active' : '' %>"><i class="fas fa-ellipsis-h"></i> 其他</a>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <a href="/videos/new" class="category-tag" style="background: var(--primary); color: white; border-color: var(--primary); float: right;">
      <i class="fas fa-plus"></i> 上传视频
    </a>
    <% } %>
  </div>

  <% if (typeof videos !== 'undefined' && videos && videos.length > 0) { %>
  <div class="video-grid">
    <% videos.forEach(function(v) { %>
      <a href="/videos/<%= v.id %>" class="video-card">
        <div class="video-thumb">
          <div class="play-icon"><i class="fas fa-play"></i></div>
        </div>
        <div class="video-info">
          <div class="video-title"><%= v.title %></div>
          <div class="video-meta">
            <span><i class="fas fa-user"></i> <%= v.author %></span>
            <span><i class="fas fa-eye"></i> <%= v.views %></span>
            <span><i class="fas fa-clock"></i> <%= (v.created_at || '').slice(0,10) %></span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
  <% } else { %>
  <div class="empty-videos">
    <i class="fas fa-video"></i>
    <h3>还没有视频</h3>
    <p>期待同学们分享校园精彩</p>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <a href="/videos/new" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 12px 24px; border-radius: 999px; text-decoration: none; display: inline-block;">
      <i class="fas fa-plus"></i> 上传第一个视频
    </a>
    <% } %>
  </div>
  <% } %>
</div>
