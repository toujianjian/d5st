<style>
.page-wrap { padding: 40px 32px; max-width: 720px; margin: 0 auto; width: 100%; }
.profile-glass {
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.7);
  border-radius: 28px;
  box-shadow: 0 16px 56px rgba(211,47,47,0.12);
  padding: 48px 40px;
  text-align: center;
}
.profile-avatar {
  width: 100px; height: 100px; margin: 0 auto 20px;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44px; color: #fff; font-weight: 700;
  box-shadow: 0 10px 36px rgba(211,47,47,0.4);
}
.profile-name { font-family: 'ZCOOL XiaoWei', serif; font-size: 26px; color: #2d2d2d; margin-bottom: 4px; }
.profile-handle { color: #888; font-size: 14px; margin-bottom: 20px; }
.secret-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 20px;
  background: rgba(211,47,47,0.1);
  border: 1px solid rgba(211,47,47,0.25);
  border-radius: 999px;
  font-family: 'Courier New', monospace; font-size: 15px; font-weight: 600; color: #b71c1c;
  letter-spacing: 2px;
}

.not-found-icon { font-size: 64px; margin-bottom: 16px; }
.not-found-text { color: #666; font-size: 15px; }
.not-found-code {
  display: inline-block; margin: 8px 0; padding: 4px 14px;
  background: rgba(211,47,47,0.1); border-radius: 10px;
  font-family: 'Courier New', monospace; font-weight: 700; color: #b71c1c;
}

.btn.primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 36px;
  background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
  color: #fff; font-size: 15px; font-weight: 600;
  border-radius: 999px; border: none; cursor: pointer;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(211,47,47,0.35);
  transition: all 0.3s ease;
  font-family: 'Noto Serif SC', serif;
}
.btn.primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(211,47,47,0.45); }

.back-link {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 28px; color: #b71c1c; text-decoration: none;
  font-size: 14px; font-weight: 500;
  transition: gap 0.2s ease;
}
.back-link:hover { gap: 10px; }

@media (max-width: 600px) {
  .page-wrap { padding: 24px 16px; }
  .profile-glass { padding: 32px 20px; border-radius: 22px; }
}
</style>

<div class="page-wrap">
  <div class="profile-glass">
    <% if (typeof user !== 'undefined' && user) { %>
      <div class="profile-avatar"><%= (user.avatar && user.avatar.trim()) ? user.avatar.charAt(0) : ((user.real_name || user.username || 'U').charAt(0)) %></div>
      <h2 class="profile-name"><%= user.real_name || user.username %></h2>
      <p class="profile-handle">@<%= user.username %></p>
      <div class="secret-badge"><i class="fas fa-key"></i> <%= code %></div>
    <% } else { %>
      <div class="not-found-icon"><i class="fas fa-ghost"></i></div>
      <h2 class="profile-name">保密号未找到</h2>
      <p class="not-found-text">保密号 <span class="not-found-code"><%= code %></span> 暂无对应用户</p>
    <% } %>

    <div style="margin-top:28px;">
      <a href="/secret" class="btn primary"><i class="fas fa-arrow-left"></i> 返回保密号中心</a>
    </div>
  </div>
</div>
