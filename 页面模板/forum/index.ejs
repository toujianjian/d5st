<style>
  .page-container { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 20px 40px 40px; }

  /* glass-header 导航 */
  .glass-header {
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    padding: 16px 28px;
    display: flex; justify-content: space-between; align-items: center;
    box-shadow: var(--shadow-soft);
    margin-bottom: 24px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .glass-header .logo {
    font-size: 26px; font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: 'ZCOOL XiaoWei', cursive; letter-spacing: 2px;
  }
  .header-center { flex: 1; min-width: 200px; display: flex; justify-content: center; }
  .search-box {
    position: relative; width: 100%; max-width: 400px;
  }
  .search-box input {
    width: 100%;
    padding: 12px 20px 12px 44px;
    background: rgba(255,255,255,0.7);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    font-size: 14px; font-family: inherit;
    color: var(--text-dark);
    outline: none;
    transition: all 0.3s ease;
  }
  .search-box input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(211,47,47,0.15);
    background: white;
  }
  .search-box i {
    position: absolute; left: 18px; top: 50%; transform: translateY(-50%);
    color: var(--primary); font-size: 14px;
  }
  .header-actions { display: flex; gap: 10px; align-items: center; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px;
    border-radius: 50px;
    font-size: 14px; font-weight: 600; font-family: inherit;
    cursor: pointer; text-decoration: none;
    border: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    box-shadow: 0 4px 14px rgba(211,47,47,0.35);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(211,47,47,0.5);
  }
  .btn-ghost {
    background: var(--glass-bg);
    color: var(--text-dark);
    border: 1px solid var(--glass-border);
  }
  .btn-ghost:hover { background: rgba(211,47,47,0.1); color: var(--primary); }

  /* 分类标签条 */
  .toolbar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .tag-list { display: flex; gap: 10px; flex-wrap: wrap; }
  .tag {
    padding: 8px 18px;
    border-radius: 20px;
    background: var(--glass-bg);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    font-size: 13px; font-weight: 500;
    color: var(--text-light);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .tag:hover { color: var(--primary); border-color: var(--primary); transform: translateY(-1px); }
  .tag.active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; border-color: transparent;
    box-shadow: 0 4px 14px rgba(211,47,47,0.35);
  }
  .sort-tabs {
    display: flex; gap: 4px;
    background: var(--glass-bg);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    padding: 4px;
  }
  .sort-tab {
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 13px; font-weight: 500;
    color: var(--text-light);
    cursor: pointer; text-decoration: none;
    transition: all 0.3s ease;
  }
  .sort-tab:hover { color: var(--primary); }
  .sort-tab.active {
    background: white;
    color: var(--primary);
    box-shadow: 0 2px 10px rgba(211,47,47,0.15);
  }

  /* 帖子列表 */
  .post-list { display: flex; flex-direction: column; gap: 16px; }
  .post-item {
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 24px 28px;
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    text-decoration: none; color: inherit;
    display: block;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    animation: cardFloat 0.5s ease-out backwards;
  }
  .post-list .post-item:nth-child(1) { animation-delay: 0.05s; }
  .post-list .post-item:nth-child(2) { animation-delay: 0.1s; }
  .post-list .post-item:nth-child(3) { animation-delay: 0.15s; }
  .post-list .post-item:nth-child(4) { animation-delay: 0.2s; }
  .post-list .post-item:nth-child(5) { animation-delay: 0.25s; }
  .post-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(211,47,47,0.35);
  }
  @keyframes cardFloat {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .post-head {
    display: flex; align-items: center; gap: 12px; margin-bottom: 10px;
  }
  .post-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; font-size: 16px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .post-author { font-weight: 600; color: var(--text-dark); font-size: 14px; }
  .post-time { font-size: 12px; color: var(--text-muted); }
  .post-title {
    font-size: 19px; font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 8px;
    line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
    font-family: 'Noto Serif SC', serif;
  }
  .post-item:hover .post-title { color: var(--primary); }
  .post-summary {
    font-size: 14px; color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 14px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-foot {
    display: flex; gap: 22px; align-items: center;
    font-size: 13px; color: var(--text-muted);
  }
  .post-foot span {
    display: inline-flex; align-items: center; gap: 6px;
    transition: color 0.2s ease;
  }
  .post-foot i { font-size: 14px; color: var(--primary); opacity: 0.7; }
  .post-item:hover .post-foot span { color: var(--primary); }
  .post-item:hover .post-foot i { opacity: 1; }
  .post-tag-inline {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 10px;
    background: rgba(211,47,47,0.1);
    color: var(--primary);
    font-size: 12px; font-weight: 600;
    margin-left: auto;
  }

  /* 空状态 */
  .empty-state {
    text-align: center; padding: 80px 20px;
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
  }
  .empty-state i {
    font-size: 64px; color: var(--primary); opacity: 0.5;
    margin-bottom: 20px;
    display: block;
  }
  .empty-state h3 {
    font-size: 22px; color: var(--text-dark); margin-bottom: 10px;
  }
  .empty-state p { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; }

  @media (max-width: 768px) {
    .page-container { padding: 16px; }
    .glass-header { padding: 16px; border-radius: 16px; }
    .header-center { order: 3; width: 100%; }
    .btn { padding: 9px 16px; font-size: 13px; }
    .post-item { padding: 18px 20px; border-radius: 20px; }
    .post-title { font-size: 17px; }
  }

  /* 置顶/精华标记 */
  .post-item.is-top { border-left: 4px solid #d32f2f; }
  .post-item.is-hot { box-shadow: 0 0 0 2px rgba(255, 107, 53, 0.2), var(--shadow-soft); }
  .post-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 10px; border-radius: 10px;
    font-size: 11px; font-weight: 600; margin-left: 8px;
  }
  .post-badge-top { background: rgba(211, 47, 47, 0.12); color: #d32f2f; }
  .post-badge-hot { background: rgba(255, 107, 53, 0.15); color: #ff6b35; }

  /* 两列布局 */
  .forum-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 24px;
    align-items: start;
  }
  .forum-sidebar { position: sticky; top: 80px; }
  .sidebar-card {
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    padding: 18px 20px;
    margin-bottom: 18px;
    box-shadow: var(--shadow-soft);
  }
  .sidebar-title {
    font-size: 15px; font-weight: 700;
    color: var(--text-dark); margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
    font-family: 'Noto Serif SC', serif;
  }
  .sidebar-title i { color: var(--primary); }
  .sidebar-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .sidebar-tag {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 5px 12px; border-radius: 14px;
    background: rgba(211, 47, 47, 0.08); color: var(--primary-dark);
    text-decoration: none; font-size: 12px; font-weight: 500;
    transition: all 0.25s ease;
  }
  .sidebar-tag:hover { background: rgba(211, 47, 47, 0.18); }
  .sidebar-tag-count { font-size: 11px; opacity: 0.6; }
  .sidebar-users { list-style: none; padding: 0; margin: 0; }
  .sidebar-users li {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 4px; border-bottom: 1px dashed rgba(0,0,0,0.05);
    font-size: 13px;
  }
  .sidebar-users li:last-child { border-bottom: none; }
  .user-rank {
    width: 22px; height: 22px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
    background: #eee; color: #888; flex-shrink: 0;
  }
  .user-rank-1 { background: linear-gradient(135deg, #ffd700, #ff8c00); color: #fff; }
  .user-rank-2 { background: linear-gradient(135deg, #c0c0c0, #9e9e9e); color: #fff; }
  .user-rank-3 { background: linear-gradient(135deg, #cd7f32, #a0522d); color: #fff; }
  .user-name-side { flex: 1; font-weight: 500; color: var(--text-dark); }
  .user-post-count { font-size: 12px; color: var(--text-light); }

  /* 分页 */
  .pagination {
    display: flex; justify-content: center; align-items: center; gap: 16px;
    margin-top: 24px; padding: 16px;
    background: var(--glass-bg);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
  }
  .page-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 18px; border-radius: 999px;
    background: rgba(255,255,255,0.5);
    color: var(--text-dark); text-decoration: none; font-size: 13px;
    font-weight: 500; border: 1px solid rgba(0,0,0,0.06);
    transition: all 0.25s ease;
  }
  .page-btn:hover { background: rgba(211, 47, 47, 0.08); color: var(--primary); border-color: rgba(211,47,47,0.2); }
  .page-info { font-size: 13px; color: var(--text-light); }

  @media (max-width: 1024px) {
    .forum-layout { grid-template-columns: 1fr; }
    .forum-sidebar { position: static; }
  }
</style>

<div class="page-container">
  <header class="glass-header">
    <div class="logo">贴吧</div>
    <div class="header-center">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="搜索帖子、作者..." id="forumSearch" />
      </div>
    </div>
    <div class="header-actions">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a href="/forum/new" class="btn btn-primary"><i class="fas fa-pen"></i> 发帖</a>
      <% } else { %>
        <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> 登录发帖</a>
      <% } %>
    </div>
  </header>

  <div class="toolbar">
    <div class="tag-list">
      <% var cat = (typeof activeCategory !== 'undefined' && activeCategory) || 'all'; %>
      <a href="/forum" class="tag<%= cat === 'all' ? ' active' : '' %>"><i class="fas fa-fire"></i> 全部</a>
      <a href="/forum?category=life" class="tag<%= cat === 'life' ? ' active' : '' %>"><i class="fas fa-coffee"></i> 生活</a>
      <a href="/forum?category=study" class="tag<%= cat === 'study' ? ' active' : '' %>"><i class="fas fa-book"></i> 学习</a>
      <a href="/forum?category=emotion" class="tag<%= cat === 'emotion' ? ' active' : '' %>"><i class="fas fa-heart"></i> 情感</a>
      <a href="/forum?category=campus" class="tag<%= cat === 'campus' ? ' active' : '' %>"><i class="fas fa-school"></i> 校园</a>
      <a href="/forum?category=other" class="tag<%= cat === 'other' ? ' active' : '' %>"><i class="fas fa-ellipsis-h"></i> 其他</a>
    </div>
    <div class="sort-tabs">
      <% var st = (typeof activeSort !== 'undefined' && activeSort) || 'newest'; %>
      <a href="/forum?sort=newest" class="sort-tab<%= st === 'newest' ? ' active' : '' %>"><i class="fas fa-clock"></i> 最新</a>
      <a href="/forum?sort=hot" class="sort-tab<%= st === 'hot' ? ' active' : '' %>"><i class="fas fa-fire"></i> 热门</a>
      <a href="/forum?sort=essence" class="sort-tab<%= st === 'essence' ? ' active' : '' %>"><i class="fas fa-star"></i> 精华</a>
    </div>
  </div>

  <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
  <div class="forum-layout">
    <div class="forum-main">
    <div class="post-list">
    <% posts.forEach(function(post) { %>
      <a href="/forum/<%= post.id %>" class="post-item<%= post.is_top ? ' is-top' : '' %><%= post.is_hot ? ' is-hot' : '' %>">
        <div class="post-head">
          <div class="post-avatar">
            <%= (post.author && post.author.charAt(0)) || '匿' %>
          </div>
          <div style="display:flex; flex-direction:column;">
            <span class="post-author"><%= post.author || '匿名用户' %></span>
            <span class="post-time"><%= post.created_at || '' %></span>
          </div>
          <% if (post.is_top) { %><span class="post-badge post-badge-top"><i class="fas fa-thumbtack"></i> 置顶</span><% } %>
          <% if (post.is_hot) { %><span class="post-badge post-badge-hot"><i class="fas fa-fire"></i> 精华</span><% } %>
          <% if (post.category) { %>
            <span class="post-tag-inline"><%= post.category %></span>
          <% } %>
        </div>
        <h3 class="post-title"><%= post.title %></h3>
        <p class="post-summary"><%= post.content %></p>
        <div class="post-foot">
          <span><i class="fas fa-thumbs-up"></i> <%= post.likes || 0 %></span>
          <span><i class="fas fa-comment-dots"></i> <%= post.comments_count || post.comments || 0 %></span>
          <span><i class="fas fa-eye"></i> <%= post.views || 0 %></span>
        </div>
      </a>
    <% }); %>
  </div>

  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
  <div class="pagination">
    <% var qsBase = 'category=' + (activeCategory || '') + '&sort=' + (activeSort || '') + '&tag=' + (activeTag || ''); %>
    <% if (page > 1) { %>
      <a href="/forum?<%= qsBase %>&page=<%= page - 1 %>" class="page-btn"><i class="fas fa-chevron-left"></i> 上一页</a>
    <% } %>
    <span class="page-info">第 <%= page %> / <%= totalPages %> 页（共 <%= total %> 条）</span>
    <% if (page < totalPages) { %>
      <a href="/forum?<%= qsBase %>&page=<%= page + 1 %>" class="page-btn">下一页 <i class="fas fa-chevron-right"></i></a>
    <% } %>
  </div>
  <% } %>
  </div><!-- /forum-main -->

  <aside class="forum-sidebar">
    <% if (typeof popularTags !== 'undefined' && popularTags && popularTags.length > 0) { %>
    <div class="sidebar-card">
      <h4 class="sidebar-title"><i class="fas fa-tags"></i> 热门标签</h4>
      <div class="sidebar-tags">
        <% popularTags.forEach(function(t) { %>
          <a href="/forum?tag=<%= encodeURIComponent(t.name) %>" class="sidebar-tag"><%= t.name %> <span class="sidebar-tag-count"><%= t.count %></span></a>
        <% }); %>
      </div>
    </div>
    <% } %>

    <% if (typeof activeUsers !== 'undefined' && activeUsers && activeUsers.length > 0) { %>
    <div class="sidebar-card">
      <h4 class="sidebar-title"><i class="fas fa-users"></i> 活跃用户</h4>
      <ul class="sidebar-users">
        <% activeUsers.forEach(function(u, idx) { %>
          <li>
            <span class="user-rank user-rank-<%= Math.min(idx+1, 3) %>"><%= idx+1 %></span>
            <span class="user-name-side"><%= u.real_name || u.username %></span>
            <span class="user-post-count"><%= u.post_count %> 帖</span>
          </li>
        <% }); %>
      </ul>
    </div>
    <% } %>
  </aside>
  </div><!-- /forum-layout -->
  <% } else { %>
  <div class="empty-state">
    <i class="fas fa-comments"></i>
    <h3>还没有帖子</h3>
    <p>成为第一个发帖的人吧！</p>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/forum/new" class="btn btn-primary"><i class="fas fa-pen"></i> 立即发帖</a>
    <% } else { %>
      <a href="/login" class="btn btn-primary"><i class="fas fa-sign-in-alt"></i> 登录后发帖</a>
    <% } %>
  </div>
  <% } %>
</div>

<script>
  var searchInput = document.getElementById('forumSearch');
  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      var kw = e.target.value.trim().toLowerCase();
      if (!kw) {
        document.querySelectorAll('.post-item').forEach(function(el){ el.style.display=''; });
        return;
      }
      document.querySelectorAll('.post-item').forEach(function(el){
        var text = el.textContent.toLowerCase();
        el.style.display = text.indexOf(kw) !== -1 ? '' : 'none';
      });
    });
  }
</script>
