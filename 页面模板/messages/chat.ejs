<style>
  .chat-wrap {
    position: relative; z-index: 1;
    padding: 24px 20px 40px;
    display: flex; justify-content: center; align-items: flex-start;
    min-height: calc(100vh - 80px);
  }
  .chat-card {
    width: 100%; max-width: 600px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    display: flex; flex-direction: column;
    height: calc(100vh - 120px);
    min-height: 480px;
    overflow: hidden;
    position: relative;
    animation: chatPopIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes chatPopIn {
    0% { opacity: 0; transform: translateY(24px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .chat-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 50%, var(--primary) 100%);
  }
  .chat-header {
    display: flex; align-items: center; gap: 12px;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(211, 47, 47, 0.12);
    background: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }
  .chat-back {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(211, 47, 47, 0.08); color: var(--primary);
    text-decoration: none; transition: all 0.3s ease;
    flex-shrink: 0;
  }
  .chat-back:hover { background: var(--primary); color: white; transform: translateX(-2px); }
  .chat-user-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 18px;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3);
    flex-shrink: 0;
  }
  .chat-user-name {
    font-size: 17px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
  }
  .chat-user-sub {
    font-size: 12px; color: var(--text-muted); margin-top: 2px;
  }
  .chat-messages {
    flex: 1; overflow-y: auto;
    padding: 20px 16px;
    display: flex; flex-direction: column; gap: 12px;
    scroll-behavior: smooth;
  }
  .chat-messages::-webkit-scrollbar { width: 6px; }
  .chat-messages::-webkit-scrollbar-thumb { background: rgba(211, 47, 47, 0.25); border-radius: 999px; }
  .msg-row {
    display: flex; align-items: flex-end; gap: 8px;
    animation: msgSlide 0.35s ease-out;
  }
  @keyframes msgSlide {
    0% { opacity: 0; transform: translateY(8px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .msg-row.sent { flex-direction: row-reverse; }
  .msg-avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 13px;
    box-shadow: 0 3px 10px rgba(211, 47, 47, 0.25);
    flex-shrink: 0;
  }
  .msg-row.sent .msg-avatar { background: linear-gradient(135deg, var(--accent), var(--primary)); }
  .msg-bubble {
    max-width: 76%;
    padding: 10px 16px;
    font-size: 14px; line-height: 1.55;
    word-break: break-word;
    box-shadow: 0 3px 12px rgba(211, 47, 47, 0.12);
  }
  .msg-bubble.received {
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(211, 47, 47, 0.12);
    color: var(--text-dark);
    border-radius: 18px 18px 18px 6px;
  }
  .msg-bubble.sent {
    background: linear-gradient(135deg, #d32f2f, #b71c1c);
    color: white;
    border-radius: 18px 18px 6px 18px;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3);
  }
  .msg-time {
    font-size: 11px; color: var(--text-muted);
    margin-top: 4px; text-align: right;
  }
  .msg-time.light { color: rgba(255, 255, 255, 0.7); }
  .chat-empty {
    flex: 1; display: flex; align-items: center; justify-content: center;
    color: var(--text-muted); text-align: center; padding: 40px 20px;
  }
  .chat-empty i { font-size: 48px; margin-bottom: 12px; opacity: 0.4; color: var(--primary); }
  .chat-input-area {
    padding: 14px 16px 18px;
    border-top: 1px solid rgba(211, 47, 47, 0.1);
    background: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }
  .chat-input-form {
    display: flex; align-items: center; gap: 8px;
    background: white;
    border: 2px solid rgba(211, 47, 47, 0.15);
    border-radius: 999px;
    padding: 6px 6px 6px 18px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 10px rgba(211, 47, 47, 0.06);
  }
  .chat-input-form:focus-within {
    border-color: var(--primary);
    box-shadow: 0 4px 18px rgba(211, 47, 47, 0.2);
    transform: translateY(-1px);
  }
  .chat-input {
    flex: 1; border: none; outline: none;
    background: transparent;
    font-family: 'Noto Serif SC', serif;
    font-size: 14px; color: var(--text-dark);
    padding: 8px 0;
  }
  .chat-input::placeholder { color: var(--text-muted); }
  .chat-send-btn {
    width: 40px; height: 40px; border-radius: 50%;
    border: none; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; font-size: 14px;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    flex-shrink: 0;
  }
  .chat-send-btn:hover { transform: scale(1.08); box-shadow: 0 6px 18px rgba(211, 47, 47, 0.45); }
  .chat-send-btn:active { transform: scale(0.94); }
  @media (max-width: 640px) {
    .chat-card { height: calc(100vh - 80px); border-radius: 20px; }
    .chat-wrap { padding: 8px 8px 24px; }
  }
</style>

<div class="chat-wrap">
  <div class="chat-card">
    <div class="chat-header">
      <a href="/messages" class="chat-back" title="返回">
        <i class="fas fa-arrow-left"></i>
      </a>
      <% if (otherUser) { %>
        <div class="chat-user-avatar"><%= (otherUser.avatar || (otherUser.real_name || otherUser.username || 'U').charAt(0)) %></div>
        <div>
          <div class="chat-user-name"><%= otherUser.real_name || otherUser.username %></div>
          <div class="chat-user-sub">在线</div>
        </div>
      <% } else { %>
        <div class="chat-user-avatar">?</div>
        <div>
          <div class="chat-user-name">未知用户</div>
          <div class="chat-user-sub">用户不存在</div>
        </div>
      <% } %>
    </div>

    <div class="chat-messages" id="chatMessages">
      <% if (typeof messages === 'undefined' || !messages || messages.length === 0) { %>
        <div class="chat-empty">
          <div>
            <i class="fas fa-comments"></i>
            <div>还没有消息，发第一句吧</div>
          </div>
        </div>
      <% } else { %>
        <% messages.forEach(function(m) { %>
          <% const isSent = currentUser && String(m.sender_id) === String(currentUser.id); %>
          <div class="msg-row <%= isSent ? 'sent' : 'received' %>">
            <div class="msg-avatar">
              <% if (isSent) { %>
                <%= currentUser && currentUser.real_name ? currentUser.real_name.charAt(0) : (currentUser && currentUser.username ? currentUser.username.charAt(0) : '我') %>
              <% } else if (otherUser) { %>
                <%= otherUser.real_name ? otherUser.real_name.charAt(0) : (otherUser.username ? otherUser.username.charAt(0) : 'U') %>
              <% } else { %>
                U
              <% } %>
            </div>
            <div>
              <div class="msg-bubble <%= isSent ? 'sent' : 'received' %>"><%= m.content %></div>
              <div class="msg-time <%= isSent ? 'light' : '' %>"><%= new Date(m.created_at).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) %></div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <% if (otherUser) { %>
    <form class="chat-input-area" method="POST" action="/messages/chat/<%= otherUser.id %>">
      <div class="chat-input-form">
        <input type="text" name="content" class="chat-input" placeholder="输入消息..." maxlength="2000" autocomplete="off" required />
        <button type="submit" class="chat-send-btn" title="发送">
          <i class="fas fa-paper-plane"></i>
        </button>
      </div>
    </form>
    <% } %>
  </div>
</div>

<script>
  (function() {
    var list = document.getElementById('chatMessages');
    if (list) list.scrollTop = list.scrollHeight;
  })();
</script>
