{
	admin off

	# ------------------------------------------------------------
	# 信任来自内网/回环的上游代理（nginx / 各种反代容器）
	# ------------------------------------------------------------
	# 为什么要配：本文件里的 reverse_proxy 默认会用「Caddy 自己看到的对端」
	# 覆盖 X-Forwarded-Proto 与 X-Forwarded-For。生产链路是
	#   浏览器 → nginx(TLS) → Caddy → app
	# 结果是 app 永远认为请求是 http（拿不到 https），也无法得知用户真实 IP：
	#   - CSRF cookie 无法标记 Secure；
	#   - 按 IP 的限流会把所有用户算成同一个来源。
	# 声明可信上游后，Caddy 会保留/追加这些头，应用侧才拿得到真实值。
	# 只信任私有网段，公网直连不会因此获得伪造头的能力。
	servers {
		trusted_proxies static private_ranges
	}
}

# 统一入口：浏览器只访问本端口，由 Caddy 按路径分流
:8080 {
	encode gzip

	# Casdoor 部署在 /casdoor 子路径：
	# 请求剥离 /casdoor 前缀后转发给后端（后端仍以根路径服务静态资源与 API）。
	handle_path /casdoor* {
		# 静态产物（js/css/字体/图片）的引用统一带 ?v=<补丁哈希>：
		# 补丁脚本一改、或镜像里 Vite 产物的文件名一改，URL 就变，
		# 因此可以安全地长期强缓存，避免登录时几十个分片反复跨洋回源校验（登录慢的主因）。
		@asset path *.js *.css *.woff *.woff2 *.ttf *.otf *.svg *.png *.jpg *.jpeg *.gif *.ico *.map
		header @asset Cache-Control "public, max-age=31536000, immutable"

		# 其余（HTML 入口、/api/*）保持不缓存：避免复用旧产物、避免脏数据被缓存
		@nonasset not path *.js *.css *.woff *.woff2 *.ttf *.otf *.svg *.png *.jpg *.jpeg *.gif *.ico *.map
		header @nonasset Cache-Control "no-cache"

		reverse_proxy casdoor:8000 {
			header_up Host {host}
			# 后端返回的相对路径重定向（如 Location: /login）需补回 /casdoor 前缀，
			# 否则浏览器会跳到根路径而非 /casdoor。绝对 URL 形式的重定向极少出现，
			# 若遇到需在此追加 replace 规则。
			@reloc header Location ^/
			header_down @reloc Location "/casdoor{http.response.header.Location}"
		}
	}

	# Casdoor 前端构建产物中的懒加载 chunk 以绝对路径 /assets/*.js 引用
	# （Vite 打包不感知 /casdoor 子路径前缀）。d5st 自有静态资源全部在 /public 下，
	# 不占用 /assets，因此把 /assets/* 直接转发给 casdoor，
	# 否则这些 chunk 会被 d5st 的认证中间件 302 到 /login，
	# 进而在 OAuth 授权页加载时把 d5st 会话的 csrfState 反复覆盖，导致回调 CSRF 校验必失败。
	# 这些 chunk 同样带 ?v= 版本号，可强缓存。
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy casdoor:8000 {
			header_up Host {host}
		}
	}

	# 其余流量转发给 d5st 应用（根路径）
	handle {
		reverse_proxy app:35555 {
			# 显式把上游传来的协议/主机/真实 IP 透传给应用，
			# 避免 Caddy 用「自己看到的 http」覆盖，导致 app 判断不出 HTTPS
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}
}
