<style>
  .v-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 20px 70px; }
  .v-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .v-title { font-size: 26px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 10px; }
  .v-title i { color: var(--primary); }
  .v-sub { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
  .btn-up {
    display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px;
    border-radius: 12px; text-decoration: none; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; font-size: 14px; font-weight: 600; box-shadow: 0 6px 20px rgba(211,47,47,.3);
    transition: all .25s;
  }
  .btn-up:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(211,47,47,.4); }

  /* 走马灯幻灯片（推荐位） */
  .slider { position: relative; border-radius: 20px; overflow: hidden; margin-bottom: 20px; box-shadow: var(--shadow-soft); }
  .slides { position: relative; height: 300px; }
  @media (max-width: 700px) { .slides { height: 200px; } }
  .slide {
    position: absolute; inset: 0; opacity: 0; transition: opacity .6s ease; text-decoration: none; display: block;
  }
  .slide.active { opacity: 1; }
  .slide img { width: 100%; height: 100%; object-fit: cover; }
  .slide-fallback {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #d32f2f, #ff6b35);
    display: flex; align-items: center; justify-content: center; color: #fff; font-size: 46px;
  }
  .slide-cap {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 24px 18px;
    background: linear-gradient(transparent, rgba(0,0,0,.72)); color: #fff;
  }
  .slide-cap .t { font-size: 18px; font-weight: 700; }
  .slide-cap .m { font-size: 12px; opacity: .85; margin-top: 4px; }
  .dots { position: absolute; right: 16px; bottom: 16px; display: flex; gap: 6px; z-index: 3; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.5); cursor: pointer; transition: all .25s; }
  .dot.active { background: #fff; width: 20px; border-radius: 4px; }

  /* 走马灯分类导航 */
  .cat-bar { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 18px; }
  .cat-bar::-webkit-scrollbar { height: 6px; }
  .cat-bar::-webkit-scrollbar-thumb { background: rgba(211,47,47,.25); border-radius: 3px; }
  .cat-chip {
    flex-shrink: 0; display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    border-radius: 14px; text-decoration: none; font-size: 14px;
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    color: var(--text-dark); transition: all .25s cubic-bezier(.34,1.56,.64,1);
  }
  .cat-chip:hover { transform: translateY(-2px); border-color: var(--primary-light); }
  .cat-chip.active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-color: transparent; box-shadow: 0 6px 18px rgba(211,47,47,.35);
  }
  .cat-chip .cnt { font-size: 12px; opacity: .75; }

  /* 视频网格 */
  .v-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .v-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 18px; overflow: hidden; box-shadow: var(--shadow-soft);
    text-decoration: none; color: inherit; transition: all .3s cubic-bezier(.34,1.56,.64,1);
  }
  .v-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); border-color: var(--primary-light); }
  .v-thumb { position: relative; width: 100%; height: 140px; background: linear-gradient(135deg,#ffe4e4,#ffd0d0); }
  .v-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .v-thumb .ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 34px; }
  .v-dur {
    position: absolute; right: 8px; bottom: 8px; padding: 2px 7px; border-radius: 6px;
    background: rgba(0,0,0,.7); color: #fff; font-size: 11px;
  }
  .v-rec {
    position: absolute; left: 8px; top: 8px; padding: 2px 8px; border-radius: 6px;
    background: linear-gradient(135deg,#ff6b35,#d32f2f); color: #fff; font-size: 11px; font-weight: 600;
  }
  .v-info { padding: 12px 14px 14px; }
  .v-name {
    font-size: 14px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 40px;
  }
  .v-meta { font-size: 12px; color: var(--text-muted); display: flex; gap: 12px; flex-wrap: wrap; }
  .v-meta span { display: flex; align-items: center; gap: 4px; }

  .empty-box { text-align: center; padding: 60px 20px; color: var(--text-muted); grid-column: 1 / -1; }
  .empty-box i { font-size: 48px; opacity: .4; margin-bottom: 14px; }
  .pager { display: flex; justify-content: center; gap: 8px; margin-top: 24px; flex-wrap: wrap; }
  .pager a, .pager span {
    padding: 8px 14px; border-radius: 10px; font-size: 13px; text-decoration: none;
    background: rgba(255,255,255,.7); border: 1px solid rgba(211,47,47,.15); color: var(--text-light);
  }
  .pager .cur { background: var(--primary); color: #fff; border-color: var(--primary); }
</style>

<div class="v-wrap">
  <div class="v-head">
    <div>
      <div class="v-title"><i class="fas fa-play-circle"></i> 校园风采</div>
      <div class="v-sub">记录校园里的每一份精彩 · 共 <%= total %> 个视频</div>
    </div>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <a href="/videos/new" class="btn-up"><i class="fas fa-upload"></i> 上传视频</a>
    <% } else { %>
    <a href="/login" class="btn-up"><i class="fas fa-sign-in-alt"></i> 登录后上传</a>
    <% } %>
  </div>

  <!-- 走马灯幻灯片 -->
  <% if (recommended && recommended.length > 0) { %>
  <div class="slider" id="slider">
    <div class="slides" id="slides">
      <% recommended.forEach(function(v, i) { %>
      <a href="/videos/<%= v.id %>" class="slide <%= i === 0 ? 'active' : '' %>" data-i="<%= i %>">
        <% if (v.cover_url) { %>
        <img src="<%= v.cover_url %>" alt="" onerror="this.style.display='none';this.parentNode.querySelector('.slide-fallback').style.display='flex';" />
        <div class="slide-fallback" style="display:none;">🎬</div>
        <% } else { %>
        <div class="slide-fallback">🎬</div>
        <% } %>
        <div class="slide-cap">
          <div class="t"><%= v.title %></div>
          <div class="m"><i class="far fa-eye"></i> <%= v.views || 0 %> 次播放 · <%= fmtDate(v.created_at, false) %></div>
        </div>
      </a>
      <% }); %>
    </div>
    <div class="dots" id="dots">
      <% recommended.forEach(function(v, i) { %>
      <div class="dot <%= i === 0 ? 'active' : '' %>" data-i="<%= i %>"></div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- 走马灯分类导航 -->
  <div class="cat-bar">
    <a href="/videos" class="cat-chip <%= activeCategory === 'all' ? 'active' : '' %>">🎥 全部</a>
    <% (categoryStats || []).forEach(function(c) { %>
    <a href="/videos?category=<%= c.key %>" class="cat-chip <%= activeCategory === c.key ? 'active' : '' %>">
      <%= c.icon %> <%= c.label %> <span class="cnt"><%= c.count %></span>
    </a>
    <% }); %>
  </div>

  <!-- 视频列表 -->
  <div class="v-grid">
    <% if (videos && videos.length > 0) { %>
    <% videos.forEach(function(v) { %>
    <a href="/videos/<%= v.id %>" class="v-card">
      <div class="v-thumb">
        <% if (v.cover_url) { %>
        <img src="<%= v.cover_url %>" alt="" onerror="this.style.display='none'" />
        <% } else { %>
        <div class="ph">🎬</div>
        <% } %>
        <% if (v.is_recommended) { %><span class="v-rec">推荐</span><% } %>
        <% if (v.duration) { %><span class="v-dur"><%= Math.floor(v.duration/60) %>:<%= String(v.duration%60).padStart(2,'0') %></span><% } %>
      </div>
      <div class="v-info">
        <div class="v-name"><%= v.title %></div>
        <div class="v-meta">
          <span><i class="fas fa-user"></i> <%= v.author %></span>
          <span><i class="far fa-eye"></i> <%= v.views || 0 %></span>
          <span><i class="fas fa-folder"></i> <%= v.category_label %></span>
        </div>
      </div>
    </a>
    <% }); %>
    <% } else { %>
    <div class="empty-box"><i class="fas fa-film"></i><p>还没有视频，来上传第一个吧</p></div>
    <% } %>
  </div>

  <% if (totalPages > 1) { %>
  <div class="pager">
    <% if (page > 1) { %><a href="/videos?page=<%= page - 1 %><%= activeCategory !== 'all' ? '&category=' + activeCategory : '' %>">上一页</a><% } %>
    <% for (var i = 1; i <= totalPages; i++) { %>
      <% if (i === page) { %><span class="cur"><%= i %></span><% } else { %>
      <a href="/videos?page=<%= i %><%= activeCategory !== 'all' ? '&category=' + activeCategory : '' %>"><%= i %></a><% } %>
    <% } %>
    <% if (page < totalPages) { %><a href="/videos?page=<%= page + 1 %><%= activeCategory !== 'all' ? '&category=' + activeCategory : '' %>">下一页</a><% } %>
  </div>
  <% } %>
</div>

<script>
  (function () {
    var slides = document.querySelectorAll('#slides .slide');
    var dots = document.querySelectorAll('#dots .dot');
    if (!slides.length) return;
    var cur = 0;
    function go(i) {
      cur = (i + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('active', k === cur); });
      dots.forEach(function (d, k) { d.classList.toggle('active', k === cur); });
    }
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.dataset.i, 10)); });
    });
    setInterval(function () { go(cur + 1); }, 5000);
  })();
</script>
