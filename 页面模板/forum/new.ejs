<style>
  .new-wrap { max-width: 760px; margin: 0 auto; padding: 24px 20px 80px; }
  .new-title { font-size: 24px; font-weight: 700; color: var(--text-dark); margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
  .new-title i { color: var(--primary); }
  .new-sub { font-size: 13px; color: var(--text-muted); margin-bottom: 20px; }
  .form-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 20px; padding: 26px; box-shadow: var(--shadow-soft);
  }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 7px; }
  .field label i { color: var(--primary); margin-right: 5px; }
  .field input[type=text], .field textarea, .field select {
    width: 100%; padding: 12px 14px; border-radius: 12px;
    border: 1px solid rgba(211,47,47,.2); background: rgba(255,255,255,.78);
    font-family: inherit; font-size: 14px; color: var(--text-dark);
  }
  .field textarea { min-height: 180px; resize: vertical; line-height: 1.8; }
  .field input:focus, .field textarea:focus, .field select:focus {
    outline: none; border-color: var(--primary); background: rgba(255,255,255,.95);
  }
  .hint { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
  .type-picker { display: flex; gap: 10px; flex-wrap: wrap; }
  .type-opt {
    flex: 1; min-width: 110px; padding: 12px; border-radius: 14px; cursor: pointer; text-align: center;
    border: 1px solid rgba(211,47,47,.18); background: rgba(255,255,255,.6);
    font-size: 13px; color: var(--text-light); transition: all .25s;
  }
  .type-opt:hover { border-color: var(--primary-light); }
  .type-opt.active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-color: transparent; box-shadow: 0 6px 18px rgba(211,47,47,.3);
  }
  .type-opt .ic { display: block; font-size: 20px; margin-bottom: 4px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 600px) { .row2 { grid-template-columns: 1fr; } }
  .submit-row { display: flex; gap: 10px; margin-top: 22px; }
  .btn-submit {
    flex: 1; padding: 14px; border: none; border-radius: 14px; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff;
    font-size: 15px; font-weight: 600; transition: all .25s;
  }
  .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(211,47,47,.4); }
  .btn-cancel {
    padding: 14px 22px; border-radius: 14px; text-decoration: none;
    border: 1px solid rgba(0,0,0,.1); background: rgba(255,255,255,.7);
    color: var(--text-light); font-size: 15px; display: flex; align-items: center;
  }
</style>

<div class="new-wrap">
  <div class="new-title"><i class="fas fa-pen-to-square"></i> 发布帖子</div>
  <div class="new-sub">分享你的校园生活 · 发帖可获得 5 积分</div>

  <form class="form-card" id="postForm">
    <div class="field">
      <label><i class="fas fa-heading"></i> 标题</label>
      <input type="text" id="title" placeholder="给帖子起个吸引人的标题（留空自动取正文前 30 字）" />
    </div>

    <div class="field">
      <label><i class="fas fa-align-left"></i> 正文</label>
      <textarea id="content" placeholder="说点什么…（至少 2 个字）"></textarea>
    </div>

    <div class="field">
      <label><i class="fas fa-shapes"></i> 帖子类型</label>
      <div class="type-picker" id="typePicker">
        <div class="type-opt active" data-type="normal"><span class="ic">🖼️</span>图文帖</div>
        <div class="type-opt" data-type="long"><span class="ic">📝</span>长文贴</div>
        <div class="type-opt" data-type="video"><span class="ic">🎬</span>视频贴</div>
      </div>
      <input type="hidden" id="post_type" name="post_type" value="normal" />
    </div>

    <div class="row2">
      <% if (boards && boards.length > 0) { %>
      <div class="field">
        <label><i class="fas fa-layer-group"></i> 版块</label>
        <select id="board_id" name="board_id">
          <option value="">不选择</option>
          <% boards.forEach(function(b) { %>
          <option value="<%= b.id %>"><%= b.icon %> <%= b.name %></option>
          <% }); %>
        </select>
      </div>
      <% } %>
      <div class="field">
        <label><i class="fas fa-folder"></i> 分类</label>
        <select id="category" name="category">
          <% Object.keys(categories).forEach(function(k) { %>
          <option value="<%= k %>"><%= categories[k] %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="field">
      <label><i class="fas fa-tags"></i> 话题标签</label>
      <input type="text" id="tags" placeholder="用逗号或空格分隔，如：学习 考研 日常" />
      <div class="hint">热门标签能让更多人看到你的帖子</div>
    </div>

    <div class="field">
      <label><i class="fas fa-image"></i> 封面图 / 视频地址</label>
      <input type="text" id="cover_image" placeholder="长文贴填封面图 URL，视频贴填视频地址" />
      <div class="hint">长文贴建议配封面图，视频贴填写视频链接</div>
    </div>

    <div class="submit-row">
      <button type="submit" class="btn-submit"><i class="fas fa-paper-plane"></i> 发布</button>
      <a href="/forum" class="btn-cancel">取消</a>
    </div>
  </form>
</div>

<script>
  var picker = document.getElementById('typePicker');
  if (picker) {
    picker.querySelectorAll('.type-opt').forEach(function (el) {
      el.addEventListener('click', function () {
        picker.querySelectorAll('.type-opt').forEach(function (x) { x.classList.remove('active'); });
        el.classList.add('active');
        document.getElementById('post_type').value = el.dataset.type;
      });
    });
  }

  document.getElementById('postForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    var body = {
      title: document.getElementById('title').value,
      content: document.getElementById('content').value,
      post_type: document.getElementById('post_type').value,
      category: document.getElementById('category').value,
      tags: document.getElementById('tags').value,
      cover_image: document.getElementById('cover_image').value
    };
    var b = document.getElementById('board_id');
    if (b) body.board_id = b.value;

    if (!body.content || body.content.trim().length < 2) {
      alert('正文至少 2 个字');
      return;
    }
    try {
      var r = await fetch('/forum', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (r.redirected) { window.location.href = r.url; return; }
      if (r.ok) { window.location.href = '/forum'; return; }
      var d = await r.json().catch(function () { return {}; });
      alert(d.error || '发布失败');
    } catch (err) { alert('发布失败'); }
  });
</script>
