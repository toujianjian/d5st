<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>📊 概览</h3><a href="/admin">仪表盘</a>
    <h3>📋 内容管理</h3><a href="/admin/forum">帖子管理</a>
    <a href="/admin/comments">评论管理</a><a href="/admin/reports">举报管理</a>
    <h3>🔔 通知与弹窗</h3><a href="/admin/notifications">全局通知</a><a href="/admin/popups">弹窗管理</a>
    <h3>🏠 首页设置</h3><a href="/admin/home-links">首页链接</a><a href="/admin/home-banners">首页横幅</a>
    <h3>🛠️ 系统</h3><a href="/admin/path-redirects">路径重定向</a><a href="/admin/recycle-bin">回收站</a><a href="/admin/export-users">导出用户</a><a href="/admin/settings">系统设置</a>
  </aside>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">➕ 新增横幅</div>
      <form method="POST" action="/admin/home-banners">
        <div class="form-group"><label class="form-label">标题</label><input type="text" name="title" class="form-input" required></div>
        <div class="form-group"><label class="form-label">图片路径</label><input type="text" name="image_path" class="form-input" required></div>
        <div class="form-group"><label class="form-label">跳转链接（可选）</label><input type="text" name="link_url" class="form-input"></div>
        <div class="form-group"><label class="form-label">排序</label><input type="number" name="sort_order" class="form-input" value="0"></div>
        <button type="submit" class="btn btn-primary">添加</button>
      </form>
    </div>
    <div class="card">
      <div class="card-title">📋 横幅列表</div>
      <table class="table">
        <thead><tr><th>ID</th><th>标题</th><th>图片</th><th>排序</th><th>操作</th></tr></thead>
        <tbody>
          <% banners.forEach(function(b) { %>
            <tr><td><%= b.id %></td><td><%= b.title %></td><td><%= b.image_path %></td><td><%= b.sort_order %></td>
              <td><form method="POST" action="/admin/home-banners/delete/<%= b.id %>" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger btn-sm">删除</button></form></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
