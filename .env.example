# ============ MySQL ============
MYSQL_ROOT_PASSWORD=d5st_root_2026
MYSQL_DATABASE=d5st
MYSQL_USER=d5st
MYSQL_PASSWORD=d5st_pass_2026
MYSQL_PORT=3306

# ============ Casdoor ============
CASDOOR_ADMIN_USER=admin
CASDOOR_ADMIN_PASSWORD=d5st_admin_2026
# 容器内网地址（app 后端调用 Casdoor 用，无需子路径前缀）
CASDOOR_ENDPOINT=http://d5st-casdoor:8000
# 浏览器可达的 Casdoor 地址：经 Caddy 统一入口的 /casdoor 子路径访问
CASDOOR_PUBLIC_ENDPOINT=http://localhost:8080/casdoor
# OAuth 客户端信息（Casdoor 初始化时会自动创建应用并生成 client_id/secret，
# 首次启动后请把控制台输出的 client_id/client_secret 复制过来）
CASDOOR_CLIENT_ID=d5st_client
CASDOOR_CLIENT_SECRET=d5st_client_secret_2026
CASDOOR_ORGANIZATION=d5st
CASDOOR_APPLICATION=d5st-app
# Webhook 密钥（用于校验 X-Casdoor-Signature）
CASDOOR_WEBHOOK_SECRET=d5st_webhook_secret_2026

# 默认管理员账号（在 d5st 组织下自动创建，并加入 d5st-admin 组）
# 用于登录本站后台；生产环境请务必修改默认密码
DEFAULT_ADMIN_USER=d5stadmin
DEFAULT_ADMIN_PASSWORD=d5stpassword

# ============ 应用 ============
# app 进程监听端口（容器内固定 35555，由 Caddy 统一入口反代）
APP_PORT=35555
# 对外统一入口（Caddy）地址，用于拼接 OAuth 回调；Casdoor 在 /casdoor 子路径
APP_URL=http://localhost:8080
# Caddy 对外暴露端口（统一入口，替代原先直连 app / casdoor）
EXTERNAL_PORT=8080
SESSION_SECRET=d5st_session_secret_change_in_production

NODE_ENV=production

# 开发/演示登录（Casdoor 未启动时可选）
# 开启后 /login 页会显示"演示登录"按钮，可跳过 OAuth 直接登录
# 生产环境必须保持 0（默认）
ENABLE_DEV_LOGIN=0
