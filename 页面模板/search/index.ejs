<style>
  .search-wrap {
    position: relative; z-index: 1;
    padding: 40px 20px 60px;
    display: flex; justify-content: center; align-items: flex-start;
  }
  .search-container {
    width: 100%; max-width: 780px;
    display: flex; flex-direction: column; gap: 24px;
  }
  .search-hero {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 28px;
    box-shadow: var(--shadow-soft);
    padding: 36px 28px 28px;
    position: relative; overflow: hidden;
    animation: searchPopIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes searchPopIn {
    0% { opacity: 0; transform: translateY(24px) scale(0.96); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .search-hero::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 50%, var(--primary) 100%);
  }
  .search-title {
    font-size: 26px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 6px;
  }
  .search-title i {
    color: var(--primary);
    background: rgba(211, 47, 47, 0.1);
    width: 44px; height: 44px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 20px;
  }
  .search-subtitle {
    font-size: 14px; color: var(--text-muted); margin-bottom: 20px;
  }
  .search-form {
    display: flex; align-items: center; gap: 0;
    background: white;
    border: 2px solid rgba(211, 47, 47, 0.18);
    border-radius: 999px;
    padding: 6px 6px 6px 22px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 18px rgba(211, 47, 47, 0.08);
  }
  .search-form:focus-within {
    border-color: var(--primary);
    box-shadow: 0 6px 22px rgba(211, 47, 47, 0.22);
    transform: translateY(-2px);
  }
  .search-form i { color: var(--primary); font-size: 16px; flex-shrink: 0; }
  .search-input {
    flex: 1; border: none; outline: none;
    background: transparent;
    font-family: 'Noto Serif SC', serif;
    font-size: 15px; color: var(--text-dark);
    padding: 12px 14px;
  }
  .search-input::placeholder { color: var(--text-muted); }
  .search-btn {
    padding: 12px 28px; border-radius: 999px;
    border: none; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; font-size: 14px; font-weight: 600;
    font-family: 'Noto Serif SC', serif;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .search-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(211, 47, 47, 0.45); }
  .search-results {
    display: flex; flex-direction: column; gap: 20px;
  }
  .result-section {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 24px;
    box-shadow: var(--shadow-soft);
    padding: 20px 22px;
  }
  .result-section-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(211, 47, 47, 0.1);
  }
  .result-section-title {
    font-size: 16px; font-weight: 700; color: var(--text-dark);
    display: flex; align-items: center; gap: 8px;
  }
  .result-section-title i { color: var(--primary); font-size: 14px; }
  .result-count {
    font-size: 12px; color: white;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    padding: 3px 10px; border-radius: 999px;
    font-weight: 600;
  }
  .result-list { display: flex; flex-direction: column; gap: 8px; }
  .result-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; border-radius: 14px;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid transparent;
    text-decoration: none; color: inherit;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .result-item:hover {
    background: rgba(211, 47, 47, 0.05);
    border-color: rgba(211, 47, 47, 0.15);
    transform: translateX(4px);
  }
  .result-avatar {
    width: 42px; height: 42px; flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 16px;
    box-shadow: 0 3px 10px rgba(211, 47, 47, 0.25);
  }
  .result-icon {
    width: 42px; height: 42px; flex-shrink: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(211, 47, 47, 0.15), rgba(183, 28, 28, 0.1));
    display: flex; align-items: center; justify-content: center;
    color: var(--primary); font-size: 16px;
  }
  .result-body { flex: 1; min-width: 0; }
  .result-name {
    font-size: 15px; font-weight: 600; color: var(--text-dark);
    margin-bottom: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .result-preview {
    font-size: 13px; color: var(--text-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .result-meta {
    font-size: 12px; color: var(--text-muted); flex-shrink: 0;
  }
  .search-empty {
    text-align: center; padding: 56px 20px;
    background: rgba(255, 255, 255, 0.85);
    border: 1px dashed rgba(211, 47, 47, 0.25);
    border-radius: 24px;
  }
  .search-empty i {
    font-size: 52px; color: var(--primary); opacity: 0.35;
    margin-bottom: 14px;
  }
  .search-empty-title {
    font-size: 16px; color: var(--text-dark); font-weight: 600; margin-bottom: 6px;
  }
  .search-empty-text { font-size: 13px; color: var(--text-muted); }
</style>

<div class="search-wrap">
  <div class="search-container">
    <div class="search-hero">
      <h2 class="search-title"><i class="fas fa-search"></i> 搜索</h2>
      <div class="search-subtitle">搜索用户与帖子</div>
      <form class="search-form" method="GET" action="/search">
        <i class="fas fa-search"></i>
        <input type="text" name="q" class="search-input" value="<%= keyword %>" placeholder="输入关键词..." autocomplete="off" />
        <button type="submit" class="search-btn">搜索</button>
      </form>
    </div>

    <% const hasUsers = typeof users !== 'undefined' && users && users.length > 0; %>
    <% const hasPosts = typeof posts !== 'undefined' && posts && posts.length > 0; %>

    <% if (!keyword) { %>
      <div class="search-empty">
        <i class="fas fa-search"></i>
        <div class="search-empty-title">开始搜索</div>
        <div class="search-empty-text">输入关键词，发现同学与帖子</div>
      </div>
    <% } else if (!hasUsers && !hasPosts) { %>
      <div class="search-empty">
        <i class="fas fa-search-plus"></i>
        <div class="search-empty-title">没有找到 &ldquo;<%= keyword %>&rdquo;</div>
        <div class="search-empty-text">换个关键词试试？</div>
      </div>
    <% } else { %>
      <div class="search-results">
        <% if (hasUsers) { %>
          <div class="result-section">
            <div class="result-section-header">
              <div class="result-section-title"><i class="fas fa-users"></i> 用户</div>
              <span class="result-count"><%= users.length %></span>
            </div>
            <div class="result-list">
              <% users.forEach(function(u) { %>
                <a href="/user/<%= u.id %>" class="result-item">
                  <div class="result-avatar"><%= u.avatar || (u.real_name || u.username || 'U').charAt(0) %></div>
                  <div class="result-body">
                    <div class="result-name"><%= u.real_name || u.username %></div>
                    <div class="result-preview">@<%= u.username %></div>
                  </div>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
        <% if (hasPosts) { %>
          <div class="result-section">
            <div class="result-section-header">
              <div class="result-section-title"><i class="fas fa-file-alt"></i> 帖子</div>
              <span class="result-count"><%= posts.length %></span>
            </div>
            <div class="result-list">
              <% posts.forEach(function(p) { %>
                <a href="/forum/<%= p.id %>" class="result-item">
                  <div class="result-icon"><i class="fas fa-comment"></i></div>
                  <div class="result-body">
                    <div class="result-name"><%= (p.real_name || p.username || '匿名') %></div>
                    <div class="result-preview"><%= String(p.content || '').replace(/\s+/g, ' ').slice(0, 60) %></div>
                  </div>
                  <div class="result-meta"><%= new Date(p.created_at).toLocaleDateString('zh-CN') %></div>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
