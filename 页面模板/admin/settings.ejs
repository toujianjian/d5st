<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">⚙️ 系统设置</div>
      <form method="POST" action="/admin/settings">
        <% settings.forEach(function(s) { %>
          <div class="form-group">
            <label class="form-label"><%= s.setting_key %> <span style="color:var(--text-secondary);font-weight:normal;font-size:12px;"><%= s.description || '' %></span></label>
            <input type="text" name="<%= s.setting_key %>" class="form-input" value="<%= s.setting_value %>">
          </div>
        <% }); %>
        <button type="submit" class="btn btn-primary">保存设置</button>
      </form>
    </div>
  </div>
</div>
