<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">➕ 新增重定向规则</div>
      <form method="POST" action="/admin/path-redirects">
        <div style="display:grid;grid-template-columns:1fr 2fr 1fr;gap:12px;">
          <input type="text" name="path" class="form-input" placeholder="原路径 如 /forum" required>
          <input type="text" name="redirect_url" class="form-input" placeholder="跳转目标 URL（可填 /forum 等站内相对路径，或 https://...）" required>
          <input type="text" name="path_desc" class="form-input" placeholder="说明">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:12px;">添加</button>
      </form>
    </div>
    <div class="card">
      <div class="card-title">📋 重定向列表</div>
      <table class="table">
        <thead><tr><th>ID</th><th>原路径</th><th>跳转至</th><th>说明</th><th>操作</th></tr></thead>
        <tbody>
          <% redirects.forEach(function(r) { %>
            <tr><td><%= r.id %></td><td><code><%= r.path %></code></td><td><%= r.redirect_url %></td><td><%= r.path_desc || '-' %></td>
              <td><form method="POST" action="/admin/path-redirects/delete/<%= r.id %>" onsubmit="return confirm('确定删除？')"><button class="btn btn-danger btn-sm">删除</button></form></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
