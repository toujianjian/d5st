<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>📊 概览</h3>
    <a href="/admin">仪表盘</a>
    <h3>📋 内容管理</h3>
    <a href="/admin/forum">帖子管理</a>
    <a href="/admin/comments">评论管理</a>
    <a href="/admin/reports">举报管理</a>
    <h3>🔔 通知与弹窗</h3>
    <a href="/admin/notifications">全局通知</a>
    <a href="/admin/popups">弹窗管理</a>
    <h3>🏠 首页设置</h3>
    <a href="/admin/home-links">首页链接</a>
    <a href="/admin/home-banners">首页横幅</a>
    <h3>🛠️ 系统</h3>
    <a href="/admin/path-redirects">路径重定向</a>
    <a href="/admin/recycle-bin">回收站</a>
    <a href="/admin/export-users">导出用户</a>
    <a href="/admin/settings">系统设置</a>
  </aside>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">🚨 举报管理</div>
      <table class="table">
        <thead><tr><th>ID</th><th>举报人</th><th>原因</th><th>时间</th><th>状态</th><th>操作</th></tr></thead>
        <tbody>
          <% reports.forEach(function(r) { %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.reporter_name %></td>
              <td><%= r.reason %></td>
              <td><%= new Date(r.created_at).toLocaleString('zh-CN') %></td>
              <td><%= r.status === 'pending' ? '<span class="badge badge-warning">待处理</span>' : '<span class="badge badge-success">已处理</span>' %></td>
              <td>
                <% if (r.status === 'pending') { %>
                  <form method="POST" action="/admin/reports/<%= r.id %>/handle" style="display:inline;">
                    <input type="hidden" name="action" value="resolved">
                    <button class="btn btn-primary btn-sm">处理</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
