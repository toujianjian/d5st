<style>
  .page-container { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; padding: 40px 24px; }

  .form-card {
    background: var(--glass-bg);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    padding: 40px 44px;
    box-shadow: var(--shadow-hover);
    animation: slideUp 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes slideUp {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .form-head { text-align: center; margin-bottom: 32px; }
  .form-head h1 {
    font-size: 30px; font-weight: 700;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
    font-family: 'ZCOOL XiaoWei', cursive; letter-spacing: 2px;
  }
  .form-head p { font-size: 14px; color: var(--text-muted); }

  .user-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 18px;
    background: rgba(211,47,47,0.08);
    border: 1px solid rgba(211,47,47,0.2);
    border-radius: 50px;
    margin-bottom: 24px;
    font-size: 13px; color: var(--text-dark);
  }
  .user-badge .mini-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; font-size: 13px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }

  .form-vertical { display: flex; flex-direction: column; gap: 20px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-label {
    font-size: 13px; font-weight: 600;
    color: var(--text-dark);
    display: flex; align-items: center; gap: 6px;
  }
  .form-label i { color: var(--primary); }
  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 14px 18px;
    background: rgba(255,255,255,0.85);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    font-size: 15px; font-family: inherit;
    color: var(--text-dark);
    outline: none;
    transition: all 0.3s ease;
  }
  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(211,47,47,0.18);
    background: white;
  }
  .form-textarea {
    min-height: 220px;
    resize: vertical;
    line-height: 1.7;
  }

  .category-row {
    display: flex; gap: 10px; flex-wrap: wrap;
  }
  .category-option {
    padding: 10px 20px;
    border-radius: 20px;
    background: rgba(255,255,255,0.7);
    border: 1px solid var(--glass-border);
    font-size: 13px; font-weight: 500;
    color: var(--text-light);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .category-option:hover { color: var(--primary); border-color: var(--primary); }
  .category-option.selected {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; border-color: transparent;
    box-shadow: 0 4px 14px rgba(211,47,47,0.35);
  }

  .form-actions {
    display: flex; gap: 14px; justify-content: center;
    margin-top: 24px;
  }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 15px; font-weight: 600; font-family: inherit;
    cursor: pointer; text-decoration: none;
    border: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    box-shadow: 0 6px 20px rgba(211,47,47,0.4);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(211,47,47,0.55);
  }
  .btn-primary:active { transform: translateY(-1px); }
  .btn-cancel {
    background: rgba(255,255,255,0.7);
    color: var(--text-dark);
    border: 1px solid var(--glass-border);
  }
  .btn-cancel:hover { background: rgba(211,47,47,0.1); color: var(--primary); border-color: var(--primary); transform: translateY(-2px); }

  .char-counter {
    font-size: 12px; color: var(--text-muted); text-align: right;
  }
  .char-counter.warn { color: var(--primary); font-weight: 600; }

  @media (max-width: 640px) {
    .page-container { padding: 24px 16px; }
    .form-card { padding: 28px 22px; border-radius: 22px; }
    .form-head h1 { font-size: 24px; }
    .form-actions { flex-direction: column; }
    .btn { width: 100%; justify-content: center; }
  }
</style>

<div class="page-container">
  <div class="form-card">
    <div class="form-head">
      <h1>发布新帖</h1>
      <p>分享你的想法，让更多同学看到</p>
    </div>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="user-badge">
        <span class="mini-avatar"><%= (currentUser.real_name || currentUser.username || 'U').charAt(0).toUpperCase() %></span>
        <span>以 <strong><%= currentUser.real_name || currentUser.username %></strong> 的身份发帖</span>
      </div>
    <% } %>

    <form action="/forum" method="POST" class="form-vertical" id="postForm">
      <div class="form-group">
        <label class="form-label"><i class="fas fa-heading"></i> 标题</label>
        <input type="text" name="title" class="form-input" placeholder="一个吸引人的标题..." required maxlength="80" />
      </div>

      <div class="form-group">
        <label class="form-label"><i class="fas fa-tag"></i> 分类</label>
        <div class="category-row" id="categoryRow">
          <input type="hidden" name="category" id="categoryInput" value="" />
          <div class="category-option" data-value="life">☕ 生活</div>
          <div class="category-option" data-value="study">📚 学习</div>
          <div class="category-option" data-value="emotion">💗 情感</div>
          <div class="category-option" data-value="campus">🏫 校园</div>
          <div class="category-option" data-value="other">✨ 其他</div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label"><i class="fas fa-align-left"></i> 内容</label>
        <textarea name="content" class="form-textarea" placeholder="写下你想说的话..." required maxlength="2000" id="contentArea"></textarea>
        <div class="char-counter" id="charCounter">0 / 2000</div>
      </div>

      <div class="form-actions">
        <a href="/forum" class="btn btn-cancel"><i class="fas fa-times"></i> 取消</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane"></i> 发布</button>
      </div>
    </form>
  </div>
</div>

<script>
  // 分类选择
  (function(){
    var row = document.getElementById('categoryRow');
    var hidden = document.getElementById('categoryInput');
    if (!row || !hidden) return;
    var opts = row.querySelectorAll('.category-option');
    opts.forEach(function(opt){
      opt.addEventListener('click', function(){
        opts.forEach(function(o){ o.classList.remove('selected'); });
        opt.classList.add('selected');
        hidden.value = opt.getAttribute('data-value');
      });
    });
  })();

  // 字数统计
  (function(){
    var area = document.getElementById('contentArea');
    var counter = document.getElementById('charCounter');
    if (!area || !counter) return;
    area.addEventListener('input', function(){
      var len = area.value.length;
      counter.textContent = len + ' / 2000';
      if (len > 1800) counter.classList.add('warn'); else counter.classList.remove('warn');
    });
  })();

  // 提交确认
  document.getElementById('postForm').addEventListener('submit', function(e){
    var title = this.title.value.trim();
    var category = document.getElementById('categoryInput').value;
    var content = this.content.value.trim();
    if (!title) { e.preventDefault(); alert('请输入标题'); return; }
    if (!category) { e.preventDefault(); alert('请选择分类'); return; }
    if (!content) { e.preventDefault(); alert('请输入内容'); return; }
  });
</script>
