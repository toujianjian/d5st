<style>
.page-wrap { padding: 40px 32px; max-width: 880px; margin: 0 auto; width: 100%; }
.hero-glass {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 28px;
  box-shadow: 0 16px 56px rgba(211, 47, 47, 0.12);
  padding: 48px 40px;
  text-align: center;
}
.hero-icon {
  width: 80px; height: 80px; margin: 0 auto 16px;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  border-radius: 24px;
  display: flex; align-items: center; justify-content: center;
  font-size: 36px; color: #fff;
  box-shadow: 0 8px 32px rgba(211, 47, 47, 0.35);
}
.hero-title { font-family: 'ZCOOL XiaoWei', 'Noto Serif SC', serif; font-size: 32px; color: #b71c1c; margin-bottom: 8px; letter-spacing: 2px; }
.hero-sub { color: #666; font-size: 15px; margin-bottom: 36px; line-height: 1.7; }
.btn.primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 16px 48px;
  background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
  color: #fff; font-size: 16px; font-weight: 600;
  border-radius: 999px; border: none; cursor: pointer;
  text-decoration: none;
  box-shadow: 0 10px 28px rgba(211, 47, 47, 0.4);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  font-family: 'Noto Serif SC', serif;
}
.btn.primary:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(211, 47, 47, 0.5); }
.btn.ghost {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 28px;
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(211, 47, 47, 0.25);
  border-radius: 999px;
  color: #b71c1c; font-size: 14px; font-weight: 500;
  text-decoration: none; cursor: pointer;
  transition: all 0.25s ease;
}
.btn.ghost:hover { background: #fff; border-color: #d32f2f; transform: translateY(-2px); }

.new-secret-card {
  margin-top: 32px; padding: 32px;
  background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
  border-radius: 20px;
  text-align: center; color: #fff;
  box-shadow: 0 12px 40px rgba(211, 47, 47, 0.45);
  animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes popIn { 0% { opacity: 0; transform: scale(0.85); } 100% { opacity: 1; transform: scale(1); } }
.new-secret-label { font-size: 14px; opacity: 0.85; margin-bottom: 12px; letter-spacing: 2px; }
.new-secret-code { font-family: 'Courier New', monospace; font-size: 36px; font-weight: 700; letter-spacing: 8px; }

.section-title {
  margin: 48px 0 16px; font-size: 18px; color: #b71c1c; font-weight: 600;
  display: flex; align-items: center; gap: 8px;
}
.section-title::before {
  content: ''; width: 4px; height: 20px; border-radius: 4px;
  background: linear-gradient(180deg, #d32f2f, #b71c1c);
}

.history-table {
  width: 100%; border-collapse: separate; border-spacing: 0;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(20px);
  border-radius: 20px; overflow: hidden;
  box-shadow: 0 12px 36px rgba(211,47,47,0.08);
}
.history-table th {
  padding: 14px 20px; text-align: left; font-size: 13px; font-weight: 600;
  color: #b71c1c; background: rgba(211,47,47,0.08);
  text-transform: uppercase; letter-spacing: 1px;
}
.history-table td { padding: 14px 20px; font-size: 14px; border-top: 1px solid rgba(211,47,47,0.08); }
.history-table tr:hover td { background: rgba(211,47,47,0.03); }
.secret-code-cell { font-family: 'Courier New', monospace; font-size: 16px; font-weight: 700; color: #d32f2f; }

.query-section {
  margin-top: 40px; padding: 28px;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  box-shadow: 0 12px 36px rgba(211,47,47,0.08);
}
.query-row { display: flex; gap: 12px; flex-wrap: wrap; }
.query-input {
  flex: 1; min-width: 220px;
  padding: 14px 20px;
  border: 2px solid rgba(211,47,47,0.15);
  border-radius: 14px;
  background: rgba(255,255,255,0.85);
  font-size: 15px; font-family: 'Courier New', monospace; text-transform: uppercase;
  outline: none; transition: border-color 0.25s;
}
.query-input:focus { border-color: #d32f2f; }

@media (max-width: 600px) {
  .page-wrap { padding: 24px 16px; }
  .hero-glass { padding: 32px 20px; border-radius: 22px; }
  .hero-title { font-size: 24px; }
  .new-secret-code { font-size: 24px; letter-spacing: 4px; }
}
</style>

<div class="page-wrap">
  <div class="hero-glass">
    <div class="hero-icon"><i class="fas fa-key"></i></div>
    <h1 class="hero-title">保密号中心</h1>
    <p class="hero-sub">生成专属保密号，他人可通过保密号查询你的公开资料</p>

    <button id="generate-btn" class="btn primary">
      <i class="fas fa-dice"></i> 生成新保密号
    </button>

    <div id="new-secret" class="new-secret-card" style="display:none;">
      <div class="new-secret-label">你的新保密号</div>
      <div class="new-secret-code" id="new-secret-code"></div>
    </div>
  </div>

  <% if (typeof secrets !== 'undefined' && secrets && secrets.length > 0) { %>
  <h3 class="section-title"><i class="fas fa-scroll"></i> 历史保密号</h3>
  <table class="history-table">
    <thead><tr><th>保密号</th><th>生成时间</th></tr></thead>
    <tbody>
      <% secrets.forEach(function(s) { %>
        <tr>
          <td class="secret-code-cell"><%= s.secret_code %></td>
          <td><%= new Date(s.created_at).toLocaleString('zh-CN') %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <div class="query-section">
    <h3 class="section-title"><i class="fas fa-search"></i> 通过保密号查询</h3>
    <form method="GET" action="/secret/show" class="query-row">
      <input type="text" name="code" class="query-input" placeholder="输入保密号" required>
      <button type="submit" class="btn primary"><i class="fas fa-search"></i> 查询</button>
    </form>
  </div>
</div>

<script>
document.getElementById('generate-btn').addEventListener('click', function() {
  fetch('/secret/generate', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        var div = document.getElementById('new-secret');
        document.getElementById('new-secret-code').textContent = data.code;
        div.style.display = 'block';
      }
    });
});
</script>
