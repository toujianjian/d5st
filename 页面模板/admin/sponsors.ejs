<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="card" style="background:rgba(211,47,47,.06);border:1px solid rgba(211,47,47,.18);">
        <div style="font-size:14px;color:var(--primary-dark);"><i class="fas fa-info-circle"></i> <%= notice %></div>
      </div>
    <% } %>

    <div class="admin-header">
      <div>
        <div class="admin-header-title"><i class="fas fa-hand-holding-heart"></i> 赞助记录</div>
        <div class="admin-header-sub">成功订单 <%= summary.cnt || 0 %> 笔 · 累计 <%= summary.amount || 0 %> 元 · 发放 <%= summary.points || 0 %> 积分</div>
      </div>
    </div>

    <div class="card">
      <% if (!sponsors || sponsors.length === 0) { %>
        <div style="padding:32px;text-align:center;color:var(--text-muted);">暂无赞助记录</div>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>ID</th><th>用户</th><th>金额（元）</th><th>发放积分</th><th>状态</th><th>时间</th><th>操作</th></tr>
          </thead>
          <tbody>
            <% sponsors.forEach(function(s) { %>
              <tr>
                <td><%= s.id %></td>
                <td><%= s.user_show || s.username || ('#' + s.user_id) %></td>
                <td><%= s.amount_yuan %></td>
                <td><%= s.points_added %></td>
                <td><%= s.status === 'success' ? '成功' : (s.status || '-') %></td>
                <td style="white-space:nowrap;"><%= fmtDate(s.created_at) %></td>
                <td>
                  <form method="POST" action="/admin/sponsors/delete/<%= s.id %>" style="display:inline;margin:0;"
                        onsubmit="return confirm('删除这条赞助记录？用户已获得的积分不会被扣回。')">
                    <button class="btn btn-danger btn-sm" type="submit">删除</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="card" style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;">
        <% for (var i = 1; i <= totalPages; i++) { if (totalPages > 12 && Math.abs(i - page) > 3 && i !== 1 && i !== totalPages) continue; %>
          <a class="btn btn-sm <%= i === page ? 'btn-primary' : 'btn-ghost' %>" href="/admin/sponsors?page=<%= i %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
