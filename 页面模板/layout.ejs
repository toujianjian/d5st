<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <%# title 兜底：部分错误处理路径（如 body 解析失败）render 时没传 title，
      直接引用会抛 ReferenceError 把 500 页面也搞崩，最终变成空响应。 %>
  <title><%= (typeof title !== 'undefined' && title && title !== siteTitle) ? (title + ' - ' + siteTitle) : (typeof siteTitle !== 'undefined' ? siteTitle : 'D5ST 校园社区') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="D5ST 校园社区 - 连接每一位同学，共享校园生活" />
  <!-- 字体：优先使用本地已装的思源宋体/站酷小薇，未安装时回退系统衬线体，避免外部 CDN 拖慢首屏 -->
<!-- ASSETS:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
  <link rel="stylesheet" href="/public/css/bundle-app.3fde26f846.css" />
  <!-- ASSETS:END -->
  <%# 关键 CSS 预加载（由构建脚本同步文件名，避免指纹变化后失配） %>
<!-- PRELOAD:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
  <%# 关键的布局与站点 CSS 并行预加载，避免串行等待 %>
  <link rel="preload" href="/public/css/layout-core.9e69ed8a75.css" as="style" />
  <link rel="preload" href="/public/css/bundle-app.3fde26f846.css" as="style" />
  <noscript>
    <link rel="stylesheet" href="/public/css/layout-core.9e69ed8a75.css" />
    <link rel="stylesheet" href="/public/css/bundle-app.3fde26f846.css" />
  </noscript>
  <!-- PRELOAD:END -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
  <script>
    /* 夜间模式偏好：在样式表解析前同步恢复，避免刷新时先闪一下浅色再变深 */
    (function () {
      try {
        if (localStorage.getItem('d5st-theme') === 'night') {
          document.documentElement.classList.add('dark-pref');
          document.addEventListener('DOMContentLoaded', function () {
            document.body.classList.add('night-mode');
          });
        }
      } catch (e) { /* 隐私模式下 localStorage 不可用，忽略 */ }
    })();
  </script>
  <!-- LAYOUT-CSS:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
  <link rel="stylesheet" href="/public/css/layout-core.9e69ed8a75.css" />
  <!-- LAYOUT-CSS:END -->
  <%# 后台公共样式：所有 /admin 页面统一注入，避免各页面样式缺失 %>
  <% if (typeof currentPath !== 'undefined' && currentPath.indexOf('/admin') === 0) { %>
  <%- include('admin/_style') %>
  <% } %>

  <script src="/public/js/main.js" defer></script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="<%= pageScript %>" defer></script>
  <% } %>
</head>
<body class="page-body<%= (typeof currentPath !== 'undefined' && currentPath.indexOf('/admin') === 0) ? ' admin-mode' : '' %>" id="page-body">
  <nav class="mobile-nav">
    <a href="/" class="mobile-nav-btn" title="首页"><i class="fas fa-home"></i></a>
    <div class="mobile-nav-menu">
      <a href="/forum" class="mobile-nav-link"><i class="fas fa-comment-dots"></i>贴吧</a>
      <a href="/search" class="mobile-nav-link"><i class="fas fa-search"></i>搜索</a>
      <a href="/secret" class="mobile-nav-link"><i class="fas fa-key"></i>保密号</a>
      <% if (typeof sponsorEnabled !== 'undefined' && sponsorEnabled) { %>
      <a href="/sponsor" class="mobile-nav-link"><i class="fas fa-heart"></i>赞助</a>
      <% } else { %>
      <a href="/sponsor" class="mobile-nav-link" style="opacity:.6;"><i class="fas fa-heart-broken"></i>赞助（暂停）</a>
      <% } %>
      <a href="/messages/guestbook" class="mobile-nav-link"><i class="fas fa-book"></i>留言板</a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a href="/friends" class="mobile-nav-link"><i class="fas fa-user-friends"></i>好友</a>
      <a href="/messages" class="mobile-nav-link"><i class="fas fa-envelope"></i>私信</a>
      <a href="/user" class="mobile-nav-link"><i class="fas fa-user"></i><%= currentUser.nickname || currentUser.real_name || currentUser.username %></a>
      <% if (currentUser.is_admin === 1) { %>
      <a href="/admin" class="mobile-nav-link"><i class="fas fa-cog"></i>管理</a>
      <% } %>
      <a href="/logout" class="mobile-nav-link"><i class="fas fa-sign-out-alt"></i>退出</a>
      <% } else { %>
      <a href="/login" class="mobile-nav-link"><i class="fas fa-sign-in-alt"></i>登录 / 注册</a>
      <% } %>
    </div>
  </nav>

  <%# 后台有自己的「回到前台」按钮，这里不再显示浮动按钮，避免压住侧边栏 %>
  <% if (typeof currentPath === 'undefined' || currentPath.indexOf('/admin') !== 0) { %>
  <a href="/" class="doc-btn"><i class="fas fa-home"></i> 首页</a>
  <% } %>

  <div class="bg-animation">
    <div class="bg-shape bg-shape-1"></div>
    <div class="bg-shape bg-shape-2"></div>
    <div class="bg-shape bg-shape-3"></div>
    <div class="bg-shape bg-shape-4"></div>
    <div class="particles">
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
      <div class="particle"></div>
    </div>
  </div>

  <% var isLoggedIn = (typeof currentUser !== 'undefined' && currentUser); %>
  <aside class="user-sidebar" id="userSidebar">
    <div class="sidebar-content">
      <% if (isLoggedIn) { %>
      <div class="user-avatar"><%= (currentUser.nickname || currentUser.real_name || currentUser.username || 'U').charAt(0) %></div>
      <div class="user-name"><%= currentUser.nickname || currentUser.real_name || currentUser.username || '用户' %></div>
      <div class="user-level" title="<%= (typeof levelIsMax !== 'undefined' && levelIsMax) ? '已达最高等级' : ('距 ' + (levelNextName || '下一级') + ' 还差 ' + (levelRemaining || 0) + ' 积分') %>">
        <span class="user-level-badge">Lv.<%= typeof userLevel !== 'undefined' ? userLevel : 1 %></span>
        <span class="user-level-name"><%= typeof userLevelName !== 'undefined' ? userLevelName : '' %></span>
      </div>
      <div class="user-stats">
        <div class="stat-item">
          <span class="stat-num"><%= typeof postCount !== 'undefined' ? postCount : 0 %></span>
          <span class="stat-label">帖子</span>
        </div>
        <div class="stat-item" title="当前积分">
          <span class="stat-num"><%= typeof userPointsText !== 'undefined' ? userPointsText : 0 %></span>
          <span class="stat-label">积分</span>
        </div>
        <div class="stat-item" title="<%= (typeof levelIsMax !== 'undefined' && levelIsMax) ? '已达最高等级' : ('距 ' + (levelNextName || '下一级') + ' 还差 ' + (levelRemaining || 0) + ' 积分') %>">
          <span class="stat-num">Lv.<%= typeof userLevel !== 'undefined' ? userLevel : 1 %></span>
          <span class="stat-label">等级</span>
        </div>
      </div>
      <div class="quick-actions">
        <a href="/" class="quick-action-btn"><i class="fas fa-home"></i> 首页</a>
        <a href="/forum" class="quick-action-btn"><i class="fas fa-comment-dots"></i> 贴吧</a>
        <a href="/friends" class="quick-action-btn"><i class="fas fa-user-friends"></i> 好友<% if (typeof friendRequestCount !== 'undefined' && friendRequestCount > 0) { %><span class="qa-badge"><%= friendRequestCount %></span><% } %></a>
        <a href="/messages" class="quick-action-btn"><i class="fas fa-envelope"></i> 私信<% if (typeof unreadMessageCount !== 'undefined' && unreadMessageCount > 0) { %><span class="qa-badge"><%= unreadMessageCount %></span><% } %></a>
        <a href="/secret" class="quick-action-btn"><i class="fas fa-key"></i> 保密号</a>
        <% if (typeof sponsorEnabled !== 'undefined' && sponsorEnabled) { %>
        <a href="/sponsor" class="quick-action-btn"><i class="fas fa-heart"></i> 赞助</a>
        <% } else { %>
        <a href="/sponsor" class="quick-action-btn" style="opacity:.6;"><i class="fas fa-heart-broken"></i> 赞助<span class="qa-badge qa-paused">暂停</span></a>
        <% } %>
        <a href="/search" class="quick-action-btn"><i class="fas fa-search"></i> 搜索</a>
        <a href="/user" class="quick-action-btn"><i class="fas fa-user"></i> 个人中心</a>
        <% if (currentUser.is_admin === 1) { %>
        <a href="/admin" class="quick-action-btn"><i class="fas fa-cog"></i> 管理后台</a>
        <% } %>
        <a href="/logout" class="quick-action-btn"><i class="fas fa-sign-out-alt"></i> 退出</a>
      </div>
      <% } else { %>
      <%# 未登录：侧栏保留（导航入口仍在），仅把用户区替换为「未登录」提示 %>
      <div class="user-avatar guest-avatar"><i class="fas fa-user"></i></div>
      <div class="user-name">未登录</div>
      <div class="guest-hint">登录后可查看帖子、私信与个人数据</div>
      <div class="quick-actions">
        <a href="/" class="quick-action-btn"><i class="fas fa-home"></i> 首页</a>
        <a href="/forum" class="quick-action-btn"><i class="fas fa-comment-dots"></i> 贴吧</a>
        <a href="/secret" class="quick-action-btn"><i class="fas fa-key"></i> 保密号</a>
        <% if (typeof sponsorEnabled !== 'undefined' && sponsorEnabled) { %>
        <a href="/sponsor" class="quick-action-btn"><i class="fas fa-heart"></i> 赞助</a>
        <% } else { %>
        <a href="/sponsor" class="quick-action-btn" style="opacity:.6;"><i class="fas fa-heart-broken"></i> 赞助<span class="qa-badge qa-paused">暂停</span></a>
        <% } %>
        <a href="/messages/guestbook" class="quick-action-btn"><i class="fas fa-book"></i> 留言板</a>
        <a href="/search" class="quick-action-btn"><i class="fas fa-search"></i> 搜索</a>
        <a href="/login" class="quick-action-btn"><i class="fas fa-sign-in-alt"></i> 登录 / 注册</a>
      </div>
      <% } %>
    </div>
  </aside>

  <%# 移动端：侧栏贴边窄条（点击展开）与遮罩 %>
  <button class="mobile-sidebar-edge" type="button" id="sidebarEdge" aria-label="展开侧栏" aria-expanded="false"><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <div class="main-wrapper" id="mainWrapper">
    <%# 无障碍：提供唯一的 main landmark，屏幕阅读器可直接跳到主内容。
        页面模板内部不要再写 <main>，否则会出现重复 landmark。 %>
    <main id="main-content">
      <%- body %>
    </main>
  </div>

  <script>
    function navigateWithTransition(url) {
      var mainWrapper = document.getElementById('mainWrapper');
      if (mainWrapper) {
        mainWrapper.classList.add('page-transition-out');
        setTimeout(function() { window.location.href = url; }, 300);
      } else {
        window.location.href = url;
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      /* 弹窗与通知推迟到浏览器空闲时再请求。
         这两个接口绝大多数时候返回空（弹窗数组为 []、通知为空），
         但请求一发出去就会占用主线程与连接，实测会把移动端首屏的可交互
         时间往后推几百毫秒。用 requestIdleCallback 让它们排在首屏渲染之后，
         没有该 API 的浏览器退回 200ms 延时——功能不受影响，只是晚一点。 */
      var later = window.requestIdleCallback
        ? function (fn) { window.requestIdleCallback(fn, { timeout: 2000 }); }
        : function (fn) { setTimeout(fn, 200); };
      later(function () {
        loadPopups();
        loadNotifications();
      });

      /* 通知铃铛：点击开合（触屏没有 hover，仅靠 :hover 打不开） */
      var nb = document.getElementById('notificationBtn');
      if (nb) {
        nb.addEventListener('click', function (e) {
          e.stopPropagation();
          document.documentElement.classList.toggle('notif-open');
        });
        document.addEventListener('click', function () {
          document.documentElement.classList.remove('notif-open');
        });
      }
    });

    /* 当前页面标识：与后台弹窗 target_pages 的取值约定一致
       （home / forum / videos / secret / user / messages / search / sponsor / all） */
    function currentPageKey() {
      var p = window.location.pathname;
      if (p === '/' || p === '') return 'home';
      var seg = p.split('/').filter(Boolean)[0] || 'home';
      return seg;
    }

    async function loadPopups() {
      // 后台不弹站内弹窗（否则覆盖层会把后台按钮全部挡住）
      if (window.location.pathname.indexOf('/admin') === 0) return;
      try {
        // 关键：必须带上当前页面，否则后端默认按 'home' 返回，
        // 会让「首页弹窗」在所有页面（含登录页）都弹出。
        var response = await fetch('/api/popups?page=' + encodeURIComponent(currentPageKey()));
        var popups = await response.json();
        if (popups.length > 0) {
          for (var i = 0; i < popups.length; i++) {
            showPopup(popups[i]);
          }
        }
      } catch (e) { /* ignore */ }
    }

    function showPopup(popup) {
      var overlay = document.createElement('div');
      overlay.className = 'popup-overlay';
      var container = document.createElement('div');
      container.className = 'popup-container';
      var closeBtn = document.createElement('button');
      closeBtn.className = 'popup-close-btn';
      closeBtn.innerHTML = '<i class="fas fa-times"></i>';
      closeBtn.onclick = function() { overlay.classList.remove('show'); setTimeout(function(){ document.body.removeChild(overlay); }, 300); };
      var title = document.createElement('h3');
      title.className = 'popup-title';
      title.textContent = popup.title || '';
      var content = document.createElement('div');
      content.className = 'popup-content';
      content.innerHTML = popup.content || '';
      var btn = document.createElement('button');
      btn.className = 'popup-btn';
      btn.textContent = '知道了';
      btn.onclick = closeBtn.onclick;
      container.appendChild(closeBtn);
      container.appendChild(title);
      container.appendChild(content);
      container.appendChild(btn);
      overlay.appendChild(container);
      document.body.appendChild(overlay);
      setTimeout(function() { overlay.classList.add('show'); }, 100);
    }

    async function loadNotifications() {
      var list = document.getElementById('notificationList');
      var btn = document.getElementById('notificationBtn');
      if (!list || !btn) return;
      try {
        var response = await fetch('/api/notifications');
        var notifications = await response.json();
        if (notifications && notifications.length > 0) {
          list.innerHTML = notifications.map(function(n) {
            return '<div class="notification-item" data-id="' + n.id + '">' +
              '<div class="notification-item-title">' + (n.title || '通知') + '</div>' +
              '<div class="notification-item-content">' + (n.content || '') + '</div>' +
              '<div class="notification-item-time">' + (n.created_at || '') + '</div></div>';
          }).join('');
          var badge = document.createElement('span');
          badge.className = 'badge';
          badge.textContent = notifications.length > 9 ? '9+' : notifications.length;
          btn.appendChild(badge);
        }
      } catch (e) { /* ignore */ }
    }

    /* 夜间模式切换：写入 localStorage 持久化，并同步按钮图标 */
    (function () {
      var toggles = document.querySelectorAll('.mode-toggle');
      if (!toggles.length) return;

      function syncIcons() {
        var isNight = document.body.classList.contains('night-mode');
        toggles.forEach(function (btn) {
          var icon = btn.querySelector('i');
          if (icon) {
            icon.className = isNight ? 'fas fa-sun' : 'fas fa-moon';
          }
          btn.setAttribute('title', isNight ? '切换日间模式' : '切换夜间模式');
        });
      }

      toggles.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var isNight = document.body.classList.toggle('night-mode');
          try {
            localStorage.setItem('d5st-theme', isNight ? 'night' : 'day');
          } catch (e) { /* ignore */ }
          syncIcons();
        });
      });

      syncIcons();
    })();

    /* 首页悬浮按钮：支持鼠标/触屏拖动，位置记入 localStorage。
       关键点：
       1. 拖动与点击要区分——位移超过阈值(5px)才判定为拖动，并阻止随后的 click 跳转；
       2. 位置用 left/top 绝对像素，写入前夹紧在视口内，避免被拖出屏幕后找不回来；
       3. 窗口尺寸变化时重新夹紧，防止缩小窗口后按钮跑到可视区外；
       4. 桌面端与移动端分开存储：两边视口尺寸差异大，共用一份位置会互相挤到角落。 */
    (function () {
      var btn = document.querySelector('.doc-btn');
      if (!btn) return;

      // 按指针类型区分存储位置（触屏设备 vs 鼠标），避免两端互相污染
      var IS_TOUCH = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
      var STORAGE_KEY = IS_TOUCH ? 'd5st-docbtn-pos-touch' : 'd5st-docbtn-pos';
      var DRAG_THRESHOLD = 5;   // 判定为拖动的位移阈值(px)
      var MARGIN = 8;           // 距视口边缘的最小间距

      var dragging = false;
      var moved = false;
      var startX = 0, startY = 0;
      var startLeft = 0, startTop = 0;

      function clamp(val, max) {
        if (max < MARGIN) return MARGIN; // 视口过窄时的兜底
        return Math.min(Math.max(val, MARGIN), max - MARGIN);
      }

      /* 用 left/top 定位，同时清掉原有的 bottom，避免两套定位互相打架 */
      function place(left, top) {
        var maxLeft = window.innerWidth - btn.offsetWidth;
        var maxTop = window.innerHeight - btn.offsetHeight;
        var l = clamp(left, maxLeft);
        var t = clamp(top, maxTop);
        btn.style.left = l + 'px';
        btn.style.top = t + 'px';
        btn.style.bottom = 'auto';
      }

      function save() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({
            left: btn.style.left,
            top: btn.style.top
          }));
        } catch (e) { /* 隐私模式忽略 */ }
      }

      /* 还原上次拖动的位置；数据损坏或越界时回落到默认左下角 */
      (function restore() {
        var saved = null;
        try {
          saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        } catch (e) { /* 忽略损坏数据 */ }
        if (saved && saved.left && saved.top) {
          btn.style.left = saved.left;
          btn.style.top = saved.top;
          btn.style.bottom = 'auto';
          place(parseFloat(saved.left), parseFloat(saved.top));
        }
      })();

      function onDown(e) {
        // 只响应鼠标左键；触屏事件无 button 字段
        if (e.type === 'mousedown' && e.button !== 0) return;
        var point = e.touches ? e.touches[0] : e;
        var rect = btn.getBoundingClientRect();

        dragging = true;
        moved = false;
        startX = point.clientX;
        startY = point.clientY;
        startLeft = rect.left;
        startTop = rect.top;

        btn.classList.add('dragging');
        // 触屏拖动时阻止页面滚动
        if (e.cancelable) e.preventDefault();
      }

      function onMove(e) {
        if (!dragging) return;
        var point = e.touches ? e.touches[0] : e;
        var dx = point.clientX - startX;
        var dy = point.clientY - startY;

        if (!moved && Math.abs(dx) + Math.abs(dy) > DRAG_THRESHOLD) {
          moved = true;
        }
        if (!moved) return;

        place(startLeft + dx, startTop + dy);
        if (e.cancelable) e.preventDefault();
      }

      function onUp() {
        if (!dragging) return;
        dragging = false;
        btn.classList.remove('dragging');
        if (moved) save();
      }

      btn.addEventListener('mousedown', onDown);
      document.addEventListener('mousemove', onMove);
      document.addEventListener('mouseup', onUp);
      btn.addEventListener('touchstart', onDown, { passive: false });
      document.addEventListener('touchmove', onMove, { passive: false });
      document.addEventListener('touchend', onUp);

      /* 拖动过就不能再触发点击跳转——否则松手瞬间会跳回首页 */
      btn.addEventListener('click', function (e) {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      });

      window.addEventListener('resize', function () {
        if (btn.style.left && btn.style.top) {
          place(parseFloat(btn.style.left), parseFloat(btn.style.top));
          save();
        }
      });
    })();
  </script>

  <%# 通知铃铛对所有人生效：已登录看到「个人通知 + 全局通知」，访客只看到全局通知 %>
  <div class="notification-ball">
    <div class="notification-panel">
      <div class="notification-panel-header"><i class="fas fa-bell"></i> 通知</div>
      <div class="notification-list" id="notificationList">
        <div class="notification-empty"><i class="fas fa-bell-slash"></i><p>暂无通知</p></div>
      </div>
    </div>
    <button class="notification-btn" id="notificationBtn" type="button" aria-label="通知"><i class="fas fa-bell" aria-hidden="true"></i></button>
  </div>

  <script>
    /* 移动端侧栏：点击左侧窄条展开/收起，点遮罩关闭 */
    (function () {
      var edge = document.getElementById('sidebarEdge');
      var backdrop = document.getElementById('sidebarBackdrop');
      if (!edge) return;
      function setOpen(open) {
        document.body.classList.toggle('sidebar-open', open);
        edge.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      edge.addEventListener('click', function () {
        setOpen(!document.body.classList.contains('sidebar-open'));
      });
      backdrop && backdrop.addEventListener('click', function () { setOpen(false); });
      // 视口变大回桌面端时兜底关闭
      window.addEventListener('resize', function () {
        if (window.innerWidth > 1024) setOpen(false);
      });
    })();
  </script>

</body>
</html>
