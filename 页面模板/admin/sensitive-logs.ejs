<style>
  .sl-card {
    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.6);
    border-radius: 22px; box-shadow: var(--shadow-soft);
    padding: 24px; display: flex; flex-direction: column; gap: 18px;
  }
  .sl-table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .sl-table th, .sl-table td { padding: 12px 14px; text-align: left; border-bottom: 1px solid rgba(0,0,0,0.06); vertical-align: top; }
  .sl-table th { font-size: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
  .sl-table tr:hover td { background: rgba(211,47,47,0.04); }
  .sl-type { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; background: rgba(211,47,47,0.1); color: var(--primary); }
  .sl-words { display: flex; flex-wrap: wrap; gap: 6px; }
  .sl-word { display: inline-block; padding: 1px 8px; border-radius: 6px; font-size: 12px; background: #fff0f0; color: #b71c1c; border: 1px solid rgba(183,28,28,0.2); }
  .sl-raw { font-size: 13px; color: var(--text-light); max-width: 320px; word-break: break-all; background: #fafafa; padding: 6px 8px; border-radius: 8px; }
  .sl-empty { text-align: center; color: var(--text-muted); padding: 30px; }
  .sl-clear { padding: 8px 18px; border-radius: 999px; border: 1px solid rgba(211,47,47,0.3); background:#fff; color: var(--primary); cursor: pointer; font-size: 13px; }
  .sl-clear:hover { background: var(--primary); color:#fff; }
</style>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar-logo">
      <div class="admin-sidebar-logo-icon"><i class="fas fa-shield-alt"></i></div>
      <div class="admin-sidebar-logo-text">
        <div class="admin-sidebar-title">D5ST 后台</div>
        <div class="admin-sidebar-sub">Admin Console</div>
      </div>
    </div>
    <nav class="admin-nav">
      <div class="admin-nav-group">概览</div>
      <a href="/admin" class="admin-nav-item"><i class="fas fa-tachometer-alt"></i> 仪表盘</a>

      <div class="admin-nav-group">内容</div>
      <a href="/admin/forum" class="admin-nav-item"><i class="fas fa-file-alt"></i> 帖子管理</a>
      <a href="/admin/comments" class="admin-nav-item"><i class="fas fa-comments"></i> 评论管理</a>
      <a href="/admin/reports" class="admin-nav-item"><i class="fas fa-exclamation-triangle"></i> 举报</a>
      <a href="/admin/videos" class="admin-nav-item"><i class="fas fa-play-circle"></i> 视频管理</a>
      <a href="/admin/boards" class="admin-nav-item"><i class="fas fa-layer-group"></i> 版块管理</a>

      <div class="admin-nav-group">互动</div>
      <a href="/admin/notifications" class="admin-nav-item"><i class="fas fa-bell"></i> 通知</a>
      <a href="/admin/popups" class="admin-nav-item"><i class="fas fa-bullhorn"></i> 弹窗</a>

      <div class="admin-nav-group">内容安全</div>
      <a href="/admin/sensitive-words" class="admin-nav-item"><i class="fas fa-ban"></i> 违禁词</a>
      <a href="/admin/sensitive-logs" class="admin-nav-item active"><i class="fas fa-history"></i> 拦截记录</a>

      <div class="admin-nav-group">首页</div>
      <a href="/admin/home-banners" class="admin-nav-item"><i class="fas fa-image"></i> 首页配图</a>
      <a href="/admin/home-links" class="admin-nav-item"><i class="fas fa-link"></i> 首页链接</a>

      <div class="admin-nav-group">系统</div>
      <a href="/admin/path-redirects" class="admin-nav-item"><i class="fas fa-random"></i> 路径重定向</a>
      <a href="/admin/export-users" class="admin-nav-item"><i class="fas fa-file-export"></i> 导出用户</a>
      <a href="/admin/recycle-bin" class="admin-nav-item"><i class="fas fa-trash"></i> 回收站</a>
      <a href="/admin/settings" class="admin-nav-item"><i class="fas fa-cog"></i> 设置</a>
    </nav>
  </aside>

  <div class="admin-content">
    <div class="admin-header">
      <div>
        <div class="admin-header-title"><i class="fas fa-history"></i> 违禁词拦截记录</div>
        <div class="admin-header-sub">每一次敏感词命中都会留痕：谁、在哪、命中了什么、原文</div>
      </div>
      <button class="sl-clear" id="clearBtn"><i class="fas fa-trash"></i> 清空记录</button>
    </div>

    <div class="sl-card">
      <table class="sl-table">
        <thead>
          <tr><th>时间</th><th>用户</th><th>类型</th><th>命中词</th><th>原文</th></tr>
        </thead>
        <tbody>
          <% if (logs.length === 0) { %>
            <tr><td colspan="5" class="sl-empty">暂无拦截记录</td></tr>
          <% } %>
          <% logs.forEach(function(l){ %>
            <tr>
              <td><%= fmtDate(l.created_at) %></td>
              <td><%= l.username || ('游客#' + (l.user_id||'?')) %></td>
              <td><span class="sl-type"><%= l.content_type %></span></td>
              <td>
                <div class="sl-words">
                  <% var mw = (typeof l.matched_words === 'string') ? JSON.parse(l.matched_words) : (l.matched_words || []); %>
                  <% mw.forEach(function(m){ %>
                    <span class="sl-word"><%= m %></span>
                  <% }); %>
                </div>
              </td>
              <td><div class="sl-raw"><%= l.raw_content %></div></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.getElementById('clearBtn').addEventListener('click', async function(){
    if (!confirm('确定清空全部拦截记录？此操作不可恢复。')) return;
    const r = await fetch('/admin/sensitive-logs/clear', { method: 'POST' });
    const j = await r.json();
    if (j.success) location.reload();
    else alert('清空失败');
  });
</script>
