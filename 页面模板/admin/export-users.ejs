<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>📊 概览</h3><a href="/admin">仪表盘</a>
    <h3>📋 内容管理</h3><a href="/admin/forum">帖子管理</a>
    <a href="/admin/comments">评论管理</a><a href="/admin/reports">举报管理</a>
    <h3>🔔 通知与弹窗</h3><a href="/admin/notifications">全局通知</a><a href="/admin/popups">弹窗管理</a>
    <h3>🏠 首页设置</h3><a href="/admin/home-links">首页链接</a><a href="/admin/home-banners">首页横幅</a>
    <h3>🛠️ 系统</h3><a href="/admin/path-redirects">路径重定向</a><a href="/admin/recycle-bin">回收站</a><a href="/admin/export-users">导出用户</a><a href="/admin/settings">系统设置</a>
  </aside>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">📥 用户数据（<%= users.length %> 人）</div>
      <table class="table">
        <thead><tr><th>ID</th><th>用户名</th><th>真实姓名</th><th>年级</th><th>班级</th><th>积分</th><th>管理员</th><th>注册时间</th></tr></thead>
        <tbody>
          <% users.forEach(function(u) { %>
            <tr>
              <td><%= u.id %></td><td><%= u.username %></td><td><%= u.real_name || '-' %></td>
              <td><%= u.grade || '-' %></td><td><%= u.class_name || '-' %></td>
              <td><%= u.points %></td>
              <td><%= u.is_admin ? '<span class="badge badge-warning">是</span>' : '-' %></td>
              <td><%= new Date(u.created_at).toLocaleDateString('zh-CN') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
