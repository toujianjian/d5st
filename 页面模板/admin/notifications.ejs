<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">🔔 发送全局通知</div>
      <form method="POST" action="/admin/notifications">
        <div class="form-group">
          <label class="form-label">标题</label>
          <input type="text" name="title" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">内容</label>
          <textarea name="content" class="form-textarea" required></textarea>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">开始时间（可选）</label>
            <input type="datetime-local" name="start_time" class="form-input">
          </div>
          <div class="form-group">
            <label class="form-label">结束时间（可选）</label>
            <input type="datetime-local" name="end_time" class="form-input">
          </div>
        </div>
        <button type="submit" class="btn btn-primary">发布通知</button>
      </form>
    </div>
    
    <div class="card">
      <div class="card-title">📜 历史通知</div>
      <% if (typeof notifications !== 'undefined' && notifications.length === 0) { %>
        <div style="padding:12px;color:var(--text-secondary);">还没有全局通知</div>
      <% } %>
      <% notifications.forEach(function(n) { %>
        <div style="padding:12px;border-bottom:1px solid var(--border);">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <strong><%= n.title %></strong>
            <span class="badge <%= n.is_active ? 'badge-success' : 'badge-default' %>"><%= n.is_active ? '活跃' : '已停用' %></span>
            <form method="POST" action="/admin/notifications/toggle/<%= n.id %>" style="display:inline;margin:0;">
              <button class="btn btn-ghost btn-sm"><%= n.is_active ? '停用' : '启用' %></button>
            </form>
            <form method="POST" action="/admin/notifications/delete/<%= n.id %>" style="display:inline;margin:0;" onsubmit="return confirm('确定删除该通知？')">
              <button class="btn btn-danger btn-sm">删除</button>
            </form>
          </div>
          <p style="color:var(--text-secondary);font-size:13px;margin-top:4px;"><%= n.content %></p>
          <small style="color:var(--text-secondary);"><%= new Date(n.created_at).toLocaleString('zh-CN') %></small>
        </div>
      <% }); %>
    </div>
  </div>
</div>
