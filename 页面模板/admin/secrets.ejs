<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <% if (typeof notice !== 'undefined' && notice) { %>
      <div class="card" style="background:rgba(211,47,47,.06);border:1px solid rgba(211,47,47,.18);">
        <div style="font-size:14px;color:var(--primary-dark);"><i class="fas fa-info-circle"></i> <%= notice %></div>
      </div>
    <% } %>

    <div class="admin-header">
      <div>
        <div class="admin-header-title"><i class="fas fa-key"></i> 保密号管理</div>
        <div class="admin-header-sub">共 <%= secrets.length %> 个 · 重置后旧号立即失效</div>
      </div>
      <form method="GET" action="/admin/secrets" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="text" name="q" value="<%= q || '' %>" placeholder="搜索保密号 / 用户名"
               style="padding:8px 12px;border-radius:10px;border:1px solid rgba(0,0,0,.12);" />
        <button class="btn btn-primary" type="submit"><i class="fas fa-search"></i> 搜索</button>
      </form>
    </div>

    <div class="card">
      <% if (!secrets || secrets.length === 0) { %>
        <div style="padding:32px;text-align:center;color:var(--text-muted);">暂无保密号</div>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>ID</th><th>用户</th><th>保密号</th><th>创建时间</th><th>操作</th></tr>
          </thead>
          <tbody>
            <% secrets.forEach(function(s) { %>
              <tr>
                <td><%= s.id %></td>
                <td><%= s.user_show || s.username || ('#' + s.user_id) %></td>
                <td><code style="font-size:14px;letter-spacing:1px;"><%= s.secret_code %></code></td>
                <td style="white-space:nowrap;"><%= fmtDate(s.created_at) %></td>
                <td>
                  <form method="POST" action="/admin/secrets/reset/<%= s.id %>" style="display:inline;margin:0;"
                        onsubmit="return confirm('重置该用户的保密号？旧号将立即失效。')">
                    <button class="btn btn-sm btn-primary" type="submit">重置</button>
                  </form>
                  <form method="POST" action="/admin/secrets/delete/<%= s.id %>" style="display:inline;margin:0;"
                        onsubmit="return confirm('删除该用户的保密号？')">
                    <button class="btn btn-sm btn-danger" type="submit">删除</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>
