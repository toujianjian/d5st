<style>
  .admin-layout {
    display: flex;
    min-height: calc(100vh - 60px);
    gap: 0;
    animation: adminFade 0.5s ease-out;
  }
  @keyframes adminFade {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .admin-sidebar {
    width: 240px; flex-shrink: 0;
    background: linear-gradient(180deg, #d32f2f 0%, #b71c1c 100%);
    color: white;
    padding: 28px 0;
    border-radius: 0 24px 24px 0;
    box-shadow: 4px 0 24px rgba(211, 47, 47, 0.25);
    display: flex; flex-direction: column;
    min-height: calc(100vh - 60px);
  }
  .admin-sidebar-logo {
    padding: 0 24px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    margin-bottom: 20px;
    display: flex; align-items: center; gap: 12px;
  }
  .admin-sidebar-logo-icon {
    width: 40px; height: 40px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .admin-sidebar-logo-text {
    display: flex; flex-direction: column;
  }
  .admin-sidebar-title {
    font-size: 16px; font-weight: 700; letter-spacing: 0.5px;
    font-family: 'Noto Serif SC', serif;
  }
  .admin-sidebar-sub {
    font-size: 11px; opacity: 0.75; margin-top: 2px;
  }
  .admin-nav {
    display: flex; flex-direction: column; gap: 2px;
    padding: 0 12px; flex: 1; overflow-y: auto;
  }
  .admin-nav-group {
    font-size: 11px; font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    padding: 14px 12px 6px;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .admin-nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    border-radius: 12px;
    font-size: 13px; font-weight: 500;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-nav-item i { width: 18px; text-align: center; font-size: 14px; }
  .admin-nav-item:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    transform: translateX(3px);
  }
  .admin-nav-item.active {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  .admin-content {
    flex: 1; min-width: 0;
    padding: 32px 32px 40px;
    display: flex; flex-direction: column; gap: 24px;
  }
  .admin-header {
    display: flex; align-items: center; justify-content: space-between;
  }
  .admin-header-title {
    font-size: 24px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
    display: flex; align-items: center; gap: 10px;
  }
  .admin-header-title i {
    color: var(--primary);
    width: 42px; height: 42px;
    background: rgba(211, 47, 47, 0.1);
    border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .admin-header-sub {
    font-size: 13px; color: var(--text-muted); margin-top: 6px;
  }
  .admin-header-action {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 999px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; text-decoration: none;
    font-size: 13px; font-weight: 600;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-header-action:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(211, 47, 47, 0.45); }
  .admin-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .admin-stat-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    box-shadow: var(--shadow-soft);
    padding: 22px 20px;
    display: flex; flex-direction: column; gap: 8px;
    position: relative; overflow: hidden;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
  .admin-stat-card::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 100px; height: 100px;
    background: radial-gradient(circle at top right, rgba(211, 47, 47, 0.08), transparent 70%);
    border-radius: 0 22px 0 100px;
  }
  .admin-stat-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 4px;
  }
  .admin-stat-icon {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 18px;
    box-shadow: 0 4px 12px rgba(211, 47, 47, 0.25);
  }
  .admin-stat-icon.posts { background: linear-gradient(135deg, #d32f2f, #b71c1c); }
  .admin-stat-icon.users { background: linear-gradient(135deg, #ff6b35, #d32f2f); }
  .admin-stat-icon.comments { background: linear-gradient(135deg, #ff5252, #d32f2f); }
  .admin-stat-icon.reports { background: linear-gradient(135deg, #b71c1c, #7f0000); }
  .admin-stat-trend {
    font-size: 11px; color: var(--text-muted);
    display: flex; align-items: center; gap: 3px;
  }
  .admin-stat-value {
    font-size: 32px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
    line-height: 1;
  }
  .admin-stat-label {
    font-size: 13px; color: var(--text-muted); font-weight: 500;
  }
  .admin-status-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    display: flex; align-items: center; gap: 16px;
  }
  .admin-status-dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: #4caf50;
    box-shadow: 0 0 0 4px rgba(76, 175, 80, 0.15);
    animation: statusPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes statusPulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(76, 175, 80, 0.15); }
    50% { box-shadow: 0 0 0 8px rgba(76, 175, 80, 0.05); }
  }
  .admin-status-title {
    font-size: 15px; font-weight: 700; color: var(--text-dark);
    margin-bottom: 2px;
  }
  .admin-status-text {
    font-size: 13px; color: var(--text-muted);
  }
  @media (max-width: 1024px) {
    .admin-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .admin-layout { flex-direction: column; }
    .admin-sidebar {
      width: 100%; min-height: auto;
      border-radius: 20px 20px 0 0;
      padding: 20px 0;
    }
    .admin-nav { flex-direction: row; flex-wrap: wrap; gap: 4px; }
    .admin-nav-group { display: none; }
    .admin-content { padding: 20px 16px; }
    .admin-stats { grid-template-columns: 1fr 1fr; }
    .admin-header { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>

<% const s = (typeof stats !== 'undefined' && stats) ? stats : {}; %>
<% const numPosts = (s.posts || 0) | 0; %>
<% const numUsers = (s.users || 0) | 0; %>
<% const numComments = (s.comments || 0) | 0; %>
<% const numReports = (s.pendingReports || s.reports || 0) | 0; %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar-logo">
      <div class="admin-sidebar-logo-icon"><i class="fas fa-shield-alt"></i></div>
      <div class="admin-sidebar-logo-text">
        <div class="admin-sidebar-title">D5ST 后台</div>
        <div class="admin-sidebar-sub">Admin Console</div>
      </div>
    </div>
    <nav class="admin-nav">
      <div class="admin-nav-group">概览</div>
      <a href="/admin" class="admin-nav-item active"><i class="fas fa-tachometer-alt"></i> 仪表盘</a>

      <div class="admin-nav-group">内容</div>
      <a href="/admin/forum" class="admin-nav-item"><i class="fas fa-file-alt"></i> 帖子管理</a>
      <a href="/admin/comments" class="admin-nav-item"><i class="fas fa-comments"></i> 评论管理</a>
      <a href="/admin/reports" class="admin-nav-item"><i class="fas fa-exclamation-triangle"></i> 举报</a>

      <div class="admin-nav-group">互动</div>
      <a href="/admin/notifications" class="admin-nav-item"><i class="fas fa-bell"></i> 通知</a>
      <a href="/admin/popups" class="admin-nav-item"><i class="fas fa-bullhorn"></i> 弹窗</a>

      <div class="admin-nav-group">首页</div>
      <a href="/admin/home-banners" class="admin-nav-item"><i class="fas fa-image"></i> 首页配图</a>
      <a href="/admin/home-links" class="admin-nav-item"><i class="fas fa-link"></i> 首页链接</a>

      <div class="admin-nav-group">系统</div>
      <a href="/admin/path-redirects" class="admin-nav-item"><i class="fas fa-random"></i> 路径重定向</a>
      <a href="/admin/export-users" class="admin-nav-item"><i class="fas fa-file-export"></i> 导出用户</a>
      <a href="/admin/recycle-bin" class="admin-nav-item"><i class="fas fa-trash"></i> 回收站</a>
      <a href="/admin/settings" class="admin-nav-item"><i class="fas fa-cog"></i> 设置</a>
    </nav>
  </aside>

  <div class="admin-content">
    <div class="admin-header">
      <div>
        <div class="admin-header-title"><i class="fas fa-chart-line"></i> 仪表盘</div>
        <div class="admin-header-sub">D5ST 校园社区运行状况概览</div>
      </div>
      <a href="/" class="admin-header-action"><i class="fas fa-external-link-alt"></i> 回到前台</a>
    </div>

    <div class="admin-stats">
      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <div class="admin-stat-icon posts"><i class="fas fa-file-alt"></i></div>
        </div>
        <div class="admin-stat-value"><%= numPosts %></div>
        <div class="admin-stat-label">帖子数</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <div class="admin-stat-icon users"><i class="fas fa-users"></i></div>
        </div>
        <div class="admin-stat-value"><%= numUsers %></div>
        <div class="admin-stat-label">用户数</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <div class="admin-stat-icon comments"><i class="fas fa-comment"></i></div>
        </div>
        <div class="admin-stat-value"><%= numComments %></div>
        <div class="admin-stat-label">评论数</div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-top">
          <div class="admin-stat-icon reports"><i class="fas fa-exclamation-triangle"></i></div>
        </div>
        <div class="admin-stat-value"><%= numReports %></div>
        <div class="admin-stat-label">举报数</div>
      </div>
    </div>

    <div class="admin-status-card">
      <div class="admin-status-dot"></div>
      <div>
        <div class="admin-status-title">系统运行中</div>
        <div class="admin-status-text">D5ST 校园社区 · Node.js + Express + MySQL + Casdoor</div>
      </div>
    </div>
  </div>
</div>
