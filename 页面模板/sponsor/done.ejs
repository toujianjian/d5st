<style>
.page-wrap { padding: 60px 32px; max-width: 560px; margin: 0 auto; width: 100%; }
.success-glass {
  background: rgba(255,255,255,0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.7);
  border-radius: 28px;
  box-shadow: 0 16px 56px rgba(211,47,47,0.12);
  padding: 56px 40px;
  text-align: center;
  animation: fadeInUp 0.6s ease-out;
}
@keyframes fadeInUp {
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0); }
}
.success-circle {
  width: 100px; height: 100px; margin: 0 auto 20px;
  background: linear-gradient(135deg, #d32f2f, #b71c1c);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44px; color: #fff;
  box-shadow: 0 10px 40px rgba(211,47,47,0.4);
  animation: popIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes popIn { 0% { transform: scale(0.6); opacity: 0; } 60% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }
.success-title { font-family: 'ZCOOL XiaoWei', serif; font-size: 28px; color: #b71c1c; margin-bottom: 6px; letter-spacing: 2px; }
.success-sub { color: #666; font-size: 14px; margin-bottom: 24px; }
.amount-badge {
  display: inline-flex; flex-direction: column; align-items: center; gap: 4px;
  padding: 20px 48px; margin-bottom: 28px;
  background: linear-gradient(135deg, rgba(211,47,47,0.08), rgba(183,28,28,0.12));
  border: 2px solid rgba(211,47,47,0.15);
  border-radius: 20px;
}
.amount-label { font-size: 13px; color: #b71c1c; letter-spacing: 2px; }
.amount-value { font-size: 48px; font-weight: 700; color: #b71c1c; font-family: 'ZCOOL XiaoWei', serif; }
.points-line { color: #666; font-size: 15px; margin-bottom: 32px; }
.points-line strong { color: #d32f2f; font-size: 18px; }

.btn.primary {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 36px;
  background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
  color: #fff; font-size: 15px; font-weight: 600;
  border-radius: 999px; border: none; cursor: pointer;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(211,47,47,0.35);
  transition: all 0.3s ease;
  font-family: 'Noto Serif SC', serif;
}
.btn.primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(211,47,47,0.45); }
.btn.ghost {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 32px; margin-left: 10px;
  background: rgba(255,255,255,0.5);
  border: 1px solid rgba(211, 47, 47, 0.25);
  border-radius: 999px;
  color: #b71c1c; font-size: 15px; font-weight: 500;
  text-decoration: none;
  transition: all 0.25s ease;
}
.btn.ghost:hover { background: #fff; border-color: #d32f2f; }

@media (max-width: 600px) {
  .page-wrap { padding: 32px 16px; }
  .success-glass { padding: 36px 20px; border-radius: 22px; }
  .amount-value { font-size: 36px; }
  .btn-group { display: flex; flex-direction: column; gap: 12px; }
  .btn-group .btn.ghost { margin-left: 0; }
}
</style>

<div class="page-wrap">
  <div class="success-glass">
    <div class="success-circle"><i class="fas fa-heart"></i></div>
    <h1 class="success-title">感谢你的支持！</h1>
    <p class="success-sub">每一份心意都让 D5ST 变得更好</p>

    <div class="amount-badge">
      <span class="amount-label">你的赞助</span>
      <span class="amount-value">¥<%= amount %></span>
    </div>

    <p class="points-line">已获得 <strong>+<%= points %></strong> 积分</p>

    <div class="btn-group">
      <a href="/user" class="btn primary"><i class="fas fa-user"></i> 前往个人中心</a>
      <a href="/" class="btn ghost"><i class="fas fa-home"></i> 返回首页</a>
    </div>
  </div>
</div>
