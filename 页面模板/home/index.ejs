<canvas class="pdaim-line-field" id="pdaimLineField" aria-hidden="true"></canvas>
<div class="page-shell">
  <span class="site-header-shadow" aria-hidden="true"></span>

  <button class="icon-button theme-toggle-float" type="button" id="themeToggle" data-liquid-glass aria-label="切换深浅色模式">
    <canvas class="liquid-glass-canvas" aria-hidden="true"></canvas>
    <span class="theme-switch-thumb" data-liquid-glass data-glass-blur="24" data-glass-alpha="1.08" aria-hidden="true">
      <canvas class="liquid-glass-canvas" aria-hidden="true"></canvas>
    </span>
    <span class="sun" aria-hidden="true"></span>
    <span class="moon" aria-hidden="true"></span>
  </button>

  <header class="site-header" data-liquid-glass aria-label="Primary navigation">
    <canvas class="liquid-glass-canvas" aria-hidden="true"></canvas>
    <span class="liquid-blob" aria-hidden="true"></span>
    <a class="logo" href="/" aria-label="D5ST home">D5ST</a>

    <nav class="nav-pills" id="primaryNav" aria-label="Sections">
      <a class="nav-pill is-active" data-liquid-glass href="/"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>首页</span></a>
      <a class="nav-pill" data-liquid-glass href="/forum"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>贴吧</span></a>
      <a class="nav-pill" data-liquid-glass href="/videos"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>风采</span></a>
      <a class="nav-pill" data-liquid-glass href="/secret"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>保密号</span></a>
      <a class="nav-pill" data-liquid-glass href="/sponsor"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>赞助</span></a>
    </nav>

    <div class="header-actions">
      <div class="auth-actions" aria-label="账户操作">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a class="auth-button auth-login" data-liquid-glass href="/user"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span><%= currentUser.real_name || currentUser.username %></span></a>
          <a class="auth-button auth-register" data-liquid-glass href="/logout"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>退出</span></a>
        <% } else { %>
          <a class="auth-button auth-login" data-liquid-glass href="/login"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>登录</span></a>
          <a class="auth-button auth-register" data-liquid-glass href="/register"><canvas class="liquid-glass-canvas" aria-hidden="true"></canvas><span>注册</span></a>
        <% } %>
      </div>
      <span class="pdaim-fps" id="pdaimFps" aria-hidden="true">-- FPS</span>
      <button class="mobile-menu-toggle" type="button" id="mobileMenuToggle" aria-controls="primaryNav" aria-expanded="false" aria-label="展开导航菜单">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <div class="pdaim-route-root" data-pdaim-route-root>
    <main class="hero route-page" data-route-page="overview" data-route-index="0" id="about">
      <section class="hero-stage" aria-labelledby="heroTitle">
        <div class="hero-copy hero-copy-base js-tilt">
          <p class="eyebrow">校园社区 · 实时连接 · 极致体验</p>
          <h1 id="heroTitle">
            <span class="title-strong">D5ST</span>
            <span class="title-light">校园社区，因你而燃</span>
          </h1>
          <p class="subtitle">发帖讨论 · 记录生活 · 分享视频，让每一次表达都成为精准的直觉。</p>
        </div>
      </section>
      <p class="scroll-hint">探索极致的响应速度 · 向下滚动解锁更多</p>
    </main>

    <div class="d5st-content">
      <!-- 数据统计条（首屏常显，避免首屏下方空白造成"没有内容"的错觉） -->
      <section class="d5st-stats">
        <div class="d5st-stat"><span class="num" data-count="<%= (typeof stats !== 'undefined' && stats) ? stats.posts : 0 %>">0</span><span class="lbl">帖子</span></div>
        <div class="d5st-stat"><span class="num" data-count="<%= (typeof stats !== 'undefined' && stats) ? stats.videos : 0 %>">0</span><span class="lbl">视频</span></div>
        <div class="d5st-stat"><span class="num" data-count="<%= (typeof stats !== 'undefined' && stats) ? stats.users : 0 %>">0</span><span class="lbl">同学</span></div>
        <div class="d5st-stat"><span class="num" data-count="<%= (typeof stats !== 'undefined' && stats) ? stats.comments : 0 %>">0</span><span class="lbl">评论</span></div>
      </section>

      <!-- 最新动态 -->
      <section class="d5st-block">
        <div class="d5st-head reveal-on-scroll" data-reveal>
          <p class="section-kicker">Latest</p>
          <h2>最新动态</h2>
          <p>看看大家最近在聊什么</p>
        </div>
        <div class="d5st-grid">
          <% if (typeof posts !== 'undefined' && posts && posts.length) { %>
            <% posts.forEach(function (p) { %>
              <a class="d5st-card reveal-on-scroll" data-reveal href="/forum/<%= p.id %>">
                <div class="d5st-pills">
                  <% if (p.is_top) { %><span class="d5st-pill top">置顶</span><% } %>
                  <% if (p.is_hot) { %><span class="d5st-pill hot">精华</span><% } %>
                  <span class="d5st-pill"><%= p.category || '综合' %></span>
                </div>
                <h3 class="d5st-title"><%= p.title %></h3>
                <p class="d5st-excerpt"><%= p.content %></p>
                <div class="d5st-meta">
                  <span><i class="fas fa-user"></i> <%= p.author %></span>
                  <span><i class="far fa-comment"></i> <%= p.comments_count %></span>
                  <span><i class="far fa-eye"></i> <%= p.views || 0 %></span>
                </div>
              </a>
            <% }); %>
          <% } else { %>
            <div class="d5st-empty">还没有帖子，去贴吧发第一篇吧</div>
          <% } %>
        </div>
      </section>

      <!-- 校园风采（视频） -->
      <section class="d5st-block">
        <div class="d5st-head reveal-on-scroll" data-reveal>
          <p class="section-kicker">Videos</p>
          <h2>校园风采</h2>
          <p>记录校园里的每一份精彩</p>
        </div>
        <div class="d5st-grid cols-4">
          <% if (typeof videos !== 'undefined' && videos && videos.length) { %>
            <% videos.forEach(function (v) { %>
              <a class="d5st-card reveal-on-scroll" data-reveal href="/videos/<%= v.id %>">
                <div class="d5st-thumb">
                  <% if (v.cover_url) { %><img src="<%= v.cover_url %>" alt="" onerror="this.style.display='none'" /><% } else { %>🎬<% } %>
                  <% if (v.duration) { %><span class="d5st-dur"><%= Math.floor(v.duration / 60) %>:<%= String(v.duration % 60).padStart(2, '0') %></span><% } %>
                </div>
                <h3 class="d5st-title" style="font-size:14px;"><%= v.title %></h3>
                <div class="d5st-meta"><span><i class="far fa-eye"></i> <%= v.views || 0 %> 次播放</span></div>
              </a>
            <% }); %>
          <% } else { %>
            <div class="d5st-empty">还没有视频</div>
          <% } %>
        </div>
      </section>

      <!-- 精彩推荐（后台横幅） -->
      <% if (typeof banners !== 'undefined' && banners && banners.length) { %>
      <section class="d5st-block">
        <div class="d5st-head reveal-on-scroll" data-reveal>
          <p class="section-kicker">Featured</p>
          <h2>精彩推荐</h2>
          <p>了解更多学校精彩内容</p>
        </div>
        <div class="d5st-grid">
          <% banners.forEach(function (b) { %>
            <a class="d5st-card reveal-on-scroll" data-reveal href="<%= b.link_url || '#' %>" <% if (b.link_url) { %>target="_blank"<% } %>>
              <div class="d5st-thumb" style="height:150px;">
                <% if (b.image_path) { %><img src="<%= b.image_path %>" alt="" onerror="this.style.display='none'" /><% } else { %><i class="fas fa-image"></i><% } %>
              </div>
              <h3 class="d5st-title" style="font-size:15px;"><%= b.title %></h3>
              <p class="d5st-excerpt"><%= b.description || b.title %></p>
            </a>
          <% }); %>
        </div>
      </section>
      <% } %>

      <!-- 常用链接 -->
      <section class="d5st-block" style="padding-bottom: 20px;">
        <div class="d5st-head reveal-on-scroll" data-reveal>
          <p class="section-kicker">Shortcuts</p>
          <h2>常用链接</h2>
          <p>便捷入口，一键直达</p>
        </div>
        <div class="d5st-grid cols-4">
          <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="/secret"><div class="d5st-link-icon"><i class="fas fa-key"></i></div><h3>保密号</h3></a>
          <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="/forum"><div class="d5st-link-icon"><i class="fas fa-comments"></i></div><h3>贴吧论坛</h3></a>
          <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="/videos"><div class="d5st-link-icon"><i class="fas fa-play"></i></div><h3>校园风采</h3></a>
          <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="/sponsor"><div class="d5st-link-icon"><i class="fas fa-heart"></i></div><h3>赞助支持</h3></a>
          <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="/messages/guestbook"><div class="d5st-link-icon"><i class="fas fa-sticky-note"></i></div><h3>留言板</h3></a>
          <% if (typeof links !== 'undefined' && links && links.length) { %>
            <% links.forEach(function (l) { %>
              <a class="d5st-card d5st-link reveal-on-scroll" data-reveal href="<%= l.url %>" target="_blank"><div class="d5st-link-icon"><i class="fas fa-link"></i></div><h3><%= l.title %></h3></a>
            <% }); %>
          <% } %>
        </div>
      </section>
    </div>
  </div>

  <div class="cursor-orb" aria-hidden="true"></div>
  <div class="cursor-pop" aria-hidden="true">
    <span class="pop-dot pop-dot-a"></span>
    <span class="pop-dot pop-dot-b"></span>
    <span class="pop-dot pop-dot-c"></span>
    <span class="pop-dot pop-dot-d"></span>
  </div>

  <div class="cursor-reveal" aria-hidden="true">
    <div class="hero-stage hero-stage-reveal">
      <div class="hero-copy hero-copy-reveal js-tilt">
        <p class="eyebrow">校园社区 · 实时连接 · 极致体验</p>
        <h2>
          <span class="title-strong">你好</span><span class="title-comma">，</span>
          <span class="title-light">这里是 D5ST</span>
        </h2>
        <p class="subtitle">让每一次表达，都成为精准的直觉。</p>
      </div>
    </div>
  </div>
</div>
