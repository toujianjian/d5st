<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">➕ 新增弹窗</div>
      <form method="POST" action="/admin/popups">
        <div class="form-group">
          <label class="form-label">标题</label>
          <input type="text" name="title" class="form-input" required>
        </div>
        <div class="form-group">
          <label class="form-label">内容</label>
          <textarea name="content" class="form-textarea" required></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">类型</label>
          <select name="type" class="form-select">
            <option value="info">信息</option>
            <option value="success">成功</option>
            <option value="warning">警告</option>
            <option value="error">错误</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">目标页面（可多选）</label>
          <div class="page-checks">
            <% pages.forEach(function (pg) { %>
              <label class="page-check">
                <input type="checkbox" name="target_pages" value="<%= pg.key %>"
                       data-all="<%= pg.key === 'all' ? '1' : '0' %>"
                       <%= pg.key === 'home' ? 'checked' : '' %>>
                <span><%= pg.label %></span>
              </label>
            <% }); %>
          </div>
          <div class="form-hint">勾选「全部页面」表示所有页面；一个都不勾按「全部页面」处理。</div>
        </div>
        <div class="form-group">
          <label class="form-label"><input type="checkbox" name="show_once" value="1"> 关闭后不再显示</label>
        </div>
        <button type="submit" class="btn btn-primary">创建弹窗</button>
      </form>
    </div>
    
    <div class="card">
      <div class="card-title">📋 弹窗列表</div>
      <table class="table">
        <thead><tr><th>ID</th><th>标题</th><th>页面</th><th>状态</th><th>排序</th><th>操作</th></tr></thead>
        <tbody>
          <% popups.forEach(function(p) { %>
            <tr>
              <td><%= p.id %></td>
              <td><%= p.title %></td>
              <td><%= String(p.target_pages || '').split(',').map(function (k) { k = k.trim(); return (pageLabels && pageLabels[k]) || k; }).filter(Boolean).join('、') %></td>
              <td><%- p.is_active ? '<span class="badge badge-success">启用</span>' : '<span class="badge badge-default">停用</span>' %></td>
              <td><%= p.sort_order %></td>
              <td style="white-space:nowrap;">
                <a href="/admin/popups/edit/<%= p.id %>" class="btn btn-ghost btn-sm">编辑</a>
                <form method="POST" action="/admin/popups/delete/<%= p.id %>" style="display:inline;margin:0;" onsubmit="return confirm('确定删除该弹窗？删除后不可恢复。');">
                  <button class="btn btn-danger btn-sm">删除</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  /* 「全部页面」与具体页面互斥：选全部则清空其它，选具体则取消全部 */
  (function () {
    var boxes = Array.prototype.slice.call(document.querySelectorAll('input[name="target_pages"]'));
    if (!boxes.length) return;
    var all = boxes.filter(function (b) { return b.dataset.all === '1'; })[0];
    boxes.forEach(function (b) {
      b.addEventListener('change', function () {
        if (b === all && b.checked) {
          boxes.forEach(function (o) { if (o !== all) o.checked = false; });
        } else if (b !== all && b.checked && all) {
          all.checked = false;
        }
      });
    });
  })();
</script>
