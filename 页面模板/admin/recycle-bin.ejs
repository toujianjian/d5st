<div class="admin-layout">
  <aside class="admin-sidebar">
    <h3>📊 概览</h3><a href="/admin">仪表盘</a>
    <h3>📋 内容管理</h3><a href="/admin/forum">帖子管理</a>
    <a href="/admin/comments">评论管理</a><a href="/admin/reports">举报管理</a><a href="/admin/videos">视频管理</a><a href="/admin/boards">版块管理</a>
    <h3>🔔 通知与弹窗</h3><a href="/admin/notifications">全局通知</a><a href="/admin/popups">弹窗管理</a>
    <h3>🏠 首页设置</h3><a href="/admin/home-links">首页链接</a><a href="/admin/home-banners">首页横幅</a>
    <h3>🛠️ 系统</h3><a href="/admin/path-redirects">路径重定向</a><a href="/admin/recycle-bin">回收站</a><a href="/admin/export-users">导出用户</a><a href="/admin/settings">系统设置</a>
  
    <h3>🛡️ 内容安全</h3>
    <a href="/admin/sensitive-words">违禁词</a>
    <a href="/admin/sensitive-logs">拦截记录</a>
</aside>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">🗑️ 回收站</div>
      <% if (items && items.length > 0) { %>
        <table class="table">
          <thead><tr><th>ID</th><th>类型</th><th>项目 ID</th><th>删除时间</th><th>操作</th></tr></thead>
          <tbody>
            <% items.forEach(function(i) { %>
              <tr>
                <td><%= i.id %></td>
                <td><%= i.item_type %></td>
                <td><%= i.item_id %></td>
                <td><%= new Date(i.deleted_at).toLocaleString('zh-CN') %></td>
                <td>
                  <button class="btn btn-sm btn-primary" onclick="restoreItem(<%= i.id %>, this)">恢复</button>
                  <button class="btn btn-sm btn-danger" onclick="purgeItem(<%= i.id %>, this)">永久删除</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <p style="text-align:center;color:var(--text-secondary);padding:40px;">回收站为空</p>
      <% } %>
    </div>
  </div>
</div>
<script>
function restoreItem(id, btn) {
  if (!confirm('确定要恢复这条记录吗？')) return;
  fetch('/admin/recycle-bin/restore/' + id, { method: 'POST' })
    .then(r => r.json())
    .then(d => { if (d.success) { btn.closest('tr').remove(); } else alert(d.error || '失败'); });
}
function purgeItem(id, btn) {
  if (!confirm('永久删除将不可恢复，确定吗？')) return;
  fetch('/admin/recycle-bin/purge/' + id, { method: 'POST' })
    .then(r => r.json())
    .then(d => { if (d.success) { btn.closest('tr').remove(); } else alert(d.error || '失败'); });
}
</script>
