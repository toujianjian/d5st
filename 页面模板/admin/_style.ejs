<style>
  /* ============================================================
     D5ST 后台公共样式
     由 layout.ejs 在所有 /admin 页面统一注入。
     原先只有仪表盘 index.ejs 自带样式，其它后台页面（设置/首页链接/
     首页横幅/通知/弹窗/回收站/导出用户/路径重定向等）用的 class
     （admin-layout / admin-sidebar / admin-nav-item / admin-header /
     admin-status-* / form-label / form-input / btn-primary …）
     在任何 CSS 里都不存在，页面因此是"裸的"。这里集中补齐。
     ============================================================ */

  .admin-layout {
    display: flex;
    min-height: calc(100vh - 60px);
    gap: 0;
    animation: adminFade 0.5s ease-out;
  }
  @keyframes adminFade {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* ---------- 侧栏 ---------- */
  .admin-sidebar {
    width: 240px; flex-shrink: 0;
    background: linear-gradient(180deg, #d32f2f 0%, #b71c1c 100%);
    color: white;
    padding: 28px 0;
    border-radius: 0 24px 24px 0;
    box-shadow: 4px 0 24px rgba(211, 47, 47, 0.25);
    display: flex; flex-direction: column;
    min-height: calc(100vh - 60px);
    /* 导航项多了以后不能让侧栏自己撑宽，也不能把内容区挤变形 */
    min-width: 0; overflow: hidden;
  }
  .admin-sidebar-logo {
    padding: 0 24px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    margin-bottom: 14px;
    display: flex; align-items: center; gap: 12px;
    color: #fff; text-decoration: none;
  }
  .admin-sidebar-logo:hover { opacity: .9; }
  .admin-sidebar-logo-icon {
    width: 40px; height: 40px; border-radius: 12px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex: none;
  }
  .admin-sidebar-logo-text { display: flex; flex-direction: column; min-width: 0; }
  .admin-sidebar-title {
    font-size: 16px; font-weight: 700; letter-spacing: 0.5px;
    font-family: 'Noto Serif SC', serif;
  }
  .admin-sidebar-sub { font-size: 11px; opacity: 0.75; margin-top: 2px; }

  /* 底部「返回站点」：与导航列表分开，滚动时始终可见 */
  .admin-sidebar-foot {
    padding: 10px 12px 0;
    margin-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .admin-nav {
    display: flex; flex-direction: column; gap: 2px;
    padding: 0 12px; flex: 1;
    overflow-y: auto; overflow-x: hidden;
    min-width: 0;
  }
  .admin-nav-group {
    font-size: 11px; font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    padding: 14px 12px 6px;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .admin-nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    border-radius: 12px;
    font-size: 13px; font-weight: 500;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-nav-item i { width: 18px; text-align: center; font-size: 14px; }
  .admin-nav-item:hover {
    background: rgba(255, 255, 255, 0.15);
    color: white;
    transform: translateX(3px);
  }
  .admin-nav-item.active {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  /* 旧版侧栏写法：<h3>分组</h3> + 纯 <a> 链接 */
  /* 说明：原先后台每个页面手写裸 <h3> + <a> 侧栏，所以这里有
     `.admin-sidebar h3` / `.admin-sidebar > a` 两条兜底样式。
     现在侧栏统一由 admin/_nav.ejs 渲染（.admin-nav / .admin-nav-item），
     这两条已无使用场景，且 `.admin-sidebar > a`（特异性 0,1,1）会压掉
     `.admin-sidebar-logo`（0,1,0）的 `display:none`，导致移动端 logo 不隐藏。
     故删除。 */

  /* ---------- 内容区 ---------- */
  .admin-content {
    flex: 1; min-width: 0;
    padding: 32px 32px 40px;
    display: flex; flex-direction: column; gap: 24px;
  }
  /* 关键：.main-wrapper 是固定 100dvh 的 flex 容器，.admin-content 会被拉伸到满高，
     卡片作为 flex 子项默认 flex-shrink:1 会被压扁，而 .card 又是 overflow:hidden，
     于是长页面（表清单、设置项多时）内容直接被裁掉且不产生滚动条，永远看不到。
     这里禁止子项收缩，让内容顶开高度、由 .main-wrapper 正常滚动。 */
  .admin-content > * { flex-shrink: 0; }
  .admin-header {
    display: flex; align-items: center; justify-content: space-between;
  }
  .admin-header-title {
    font-size: 24px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
    display: flex; align-items: center; gap: 10px;
  }
  .admin-header-title i {
    color: var(--primary);
    width: 42px; height: 42px;
    background: rgba(211, 47, 47, 0.1);
    border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .admin-header-sub { font-size: 13px; color: var(--text-muted); margin-top: 6px; }
  .admin-header-action {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 999px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white; text-decoration: none;
    font-size: 13px; font-weight: 600;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.3);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-header-action:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(211, 47, 47, 0.45); }

  /* ---------- 统计卡 ---------- */
  .admin-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .admin-stat-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    box-shadow: var(--shadow-soft);
    padding: 22px 20px;
    display: flex; flex-direction: column; gap: 8px;
    position: relative; overflow: hidden;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .admin-stat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
  .admin-stat-card::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 100px; height: 100px;
    background: radial-gradient(circle at top right, rgba(211, 47, 47, 0.08), transparent 70%);
    border-radius: 0 22px 0 100px;
  }
  .admin-stat-top {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 4px;
  }
  .admin-stat-icon {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 18px;
    box-shadow: 0 4px 12px rgba(211, 47, 47, 0.25);
  }
  .admin-stat-icon.posts { background: linear-gradient(135deg, #d32f2f, #b71c1c); }
  .admin-stat-icon.users { background: linear-gradient(135deg, #ff6b35, #d32f2f); }
  .admin-stat-icon.comments { background: linear-gradient(135deg, #ff5252, #d32f2f); }
  .admin-stat-icon.reports { background: linear-gradient(135deg, #b71c1c, #7f0000); }
  .admin-stat-icon.videos { background: linear-gradient(135deg, #c2185b, #7b1fa2); }
  .admin-stat-trend {
    font-size: 11px; color: var(--text-muted);
    display: flex; align-items: center; gap: 3px;
  }
  .admin-stat-value {
    font-size: 32px; font-weight: 700; color: var(--text-dark);
    font-family: 'Noto Serif SC', serif;
    line-height: 1;
  }
  .admin-stat-label { font-size: 13px; color: var(--text-muted); font-weight: 500; }

  /* ---------- 状态提示条 ---------- */
  .admin-status-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 22px;
    box-shadow: var(--shadow-soft);
    padding: 22px 24px;
    display: flex; align-items: center; gap: 16px;
  }
  .admin-status-dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: #4caf50;
    box-shadow: 0 0 0 4px rgba(76, 175, 80, 0.15);
    animation: statusPulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes statusPulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(76, 175, 80, 0.15); }
    50% { box-shadow: 0 0 0 8px rgba(76, 175, 80, 0.05); }
  }
  .admin-status-title { font-size: 15px; font-weight: 700; color: var(--text-dark); margin-bottom: 2px; }
  .admin-status-text { font-size: 13px; color: var(--text-muted); }

  /* ---------- 表单（旧版后台用的 form-label / form-input） ---------- */
  .admin-content .form-group { margin-bottom: 16px; }
  .admin-content .form-label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px; font-weight: 600;
    color: var(--text-dark);
  }
  .admin-content .form-input,
  .admin-content input[type="text"],
  .admin-content input[type="number"],
  .admin-content input[type="password"],
  .admin-content select,
  .admin-content textarea {
    width: 100%;
    padding: 11px 14px;
    border-radius: 12px;
    border: 1px solid rgba(211, 47, 47, 0.2);
    background: #fff;
    font-size: 14px; font-family: inherit;
    color: var(--text-dark);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .admin-content .form-input:focus,
  .admin-content input:focus,
  .admin-content select:focus,
  .admin-content textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(211, 47, 47, 0.12);
  }

  /* ---------- 勾选式多选（如弹窗「目标页面」） ---------- */
  .admin-content .page-checks {
    display: flex; flex-wrap: wrap; gap: 10px;
    padding: 12px 14px;
    border: 1px dashed rgba(211, 47, 47, 0.25);
    border-radius: 14px;
    background: rgba(211, 47, 47, 0.02);
  }
  .admin-content .page-check {
    display: inline-flex; align-items: center; gap: 7px;
    flex: 0 0 auto;              /* 不被 flex 压缩，否则文字会竖排 */
    white-space: nowrap;
    padding: 7px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(211, 47, 47, 0.18);
    font-size: 13px; font-weight: 500;
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .admin-content .page-check span { line-height: 1.4; }
  .admin-content .page-check:hover { border-color: var(--primary); }
  .admin-content .page-check input { accent-color: var(--primary); cursor: pointer; margin: 0; }
  .admin-content .page-check:has(input:checked) {
    background: linear-gradient(135deg, rgba(211, 47, 47, 0.1), rgba(183, 28, 28, 0.06));
    border-color: var(--primary);
    color: var(--primary);
    font-weight: 600;
  }
  .admin-content .form-hint { font-size: 12px; color: var(--text-muted); margin-top: 8px; }

  /* ---------- 按钮（旧版后台用的 btn-primary / btn-danger / btn-ghost / btn-sm） ---------- */
  .admin-content .btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
  }
  .admin-content .btn-danger {
    background: rgba(211, 47, 47, 0.08);
    color: #c62828;
    border: 1px solid rgba(211, 47, 47, 0.25);
  }
  .admin-content .btn-danger:hover { background: #d32f2f; color: #fff; }
  .admin-content .btn-ghost {
    background: rgba(255, 255, 255, 0.9);
    color: var(--primary);
    border: 1px solid rgba(211, 47, 47, 0.2);
  }
  .admin-content .btn-ghost:hover { background: rgba(255, 245, 245, 0.98); }
  .admin-content .btn-warning {
    background: rgba(255, 152, 0, 0.12);
    color: #e65100;
    border: 1px solid rgba(255, 152, 0, 0.3);
  }
  .admin-content .btn-warning:hover { background: #ff9800; color: #fff; }
  .admin-content .btn-sm {
    padding: 6px 14px;
    font-size: 12px;
    border-radius: 999px;
  }
  .admin-content button.btn { cursor: pointer; border: none; font-family: inherit; }

  /* ---------- 徽标（覆盖站点 .badge 的弹跳/大字号，后台用扁平小徽标） ---------- */
  .admin-content .badge {
    display: inline-flex; align-items: center;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px; font-weight: 600;
    line-height: 1.6;
    animation: none;
    background: rgba(0, 0, 0, 0.06);
    color: var(--text-muted);
  }
  .admin-content .badge-success { background: rgba(76, 175, 80, 0.12); color: #2e7d32; }
  .admin-content .badge-danger { background: rgba(211, 47, 47, 0.12); color: #c62828; }
  .admin-content .badge-warning { background: rgba(255, 152, 0, 0.14); color: #e65100; }
  /* 中性徽标：新增的标签/名册等页面用到（原来只定义了 success/danger/warning） */
  .admin-content .badge-default { background: rgba(0, 0, 0, 0.06); color: var(--text-muted); }

  /* ---------- 卡片标题 ----------
     新页面（留言板/私信/赞助/标签/勋章/积分/保密号/名册）沿用了 .card-title，
     此前只有个别页面自带定义，这里统一到公共样式。 */
  .admin-content .card-title {
    display: flex; align-items: center; gap: 8px;
    font-size: 15px; font-weight: 700;
    color: var(--text-dark);
    margin-bottom: 14px;
  }
  .admin-content .card-title i { color: var(--primary); }


  /* ---------- 表格 ---------- */
  .admin-content table,
  .admin-content .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
  }
  .admin-content th,
  .admin-content td { padding: 12px 14px; text-align: left; border-bottom: 1px solid rgba(0, 0, 0, 0.06); }
  .admin-content th {
    font-size: 12px; color: var(--text-muted); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.5px;
    background: rgba(211, 47, 47, 0.04);
  }
  .admin-content tbody tr:hover { background: rgba(211, 47, 47, 0.03); }

  /* ---------- 响应式 ---------- */
  @media (max-width: 1024px) {
    .admin-stats { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---- 平板/手机：后台整体重排 ----
     原实现的问题（实测 iPhone 390px）：
       1) 侧栏 width:100% 后有 19 个菜单项竖排，把整个首屏吃满，
          每进一个页面都要先滚过整段菜单；
       2) 表格最小内容宽度约 1843px，被裁在 390px 视口里且不能横向滚动，
          右侧「置顶 / 精华 / 删除」按钮根本点不到；
       3) flex 项默认 min-width:auto，表格的最小宽度会一路把
          main → .admin-layout → .admin-sidebar 全部顶宽到 1800px+。
     处理方式：
       - 打断 min-width 传递链（下面的 min-width:0 一组）
       - 表格交给 main.js 统一包一层 .table-scroll（横向滚动容器） */

  /* 打断 flex/grid 项的 min-width:auto 传递，防止表格把祖先撑宽 */
  body.admin-mode .main-wrapper,
  body.admin-mode main,
  .admin-layout,
  .admin-sidebar,
  .admin-content,
  .admin-content > * { min-width: 0; }

  /* 表格横向滚动容器（main.js 会自动给每张后台表格套上） */
  .table-scroll {
    width: 100%; max-width: 100%;
    overflow-x: auto; overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    border-radius: 12px;
  }
  .table-scroll::-webkit-scrollbar { height: 6px; }
  .table-scroll::-webkit-scrollbar-thumb { background: rgba(211,47,47,.35); border-radius: 3px; }
  .table-scroll table { min-width: max-content; }

  @media (max-width: 768px) {
    .admin-layout { flex-direction: column; min-height: auto; }

    /* 侧栏：紧凑顶部条 + 横向滑动菜单，不再占满首屏 */
    .admin-sidebar {
      width: 100%; min-height: auto;
      border-radius: 0 0 20px 20px;
      padding: 8px 0 10px;
      position: sticky; top: 0; z-index: 400;
    }
    .admin-sidebar-logo { display: none; }
    .admin-nav {
      flex-direction: row; flex-wrap: nowrap;
      gap: 6px; padding: 0 12px;
      overflow-x: auto; overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .admin-nav::-webkit-scrollbar { display: none; }
    .admin-nav-group { display: none; }
    .admin-nav-item {
      flex: 0 0 auto; white-space: nowrap;
      padding: 8px 14px; font-size: 13px;
    }
    .admin-nav-item i { width: auto; }
    .admin-nav-item:hover { transform: none; }

    /* 内容区 */
    .admin-content { padding: 16px 12px; }
    .admin-header { flex-direction: column; align-items: flex-start; gap: 10px; }
    .admin-header h1, .admin-header .admin-title { font-size: 1.15rem; line-height: 1.35; }
    .admin-stats { grid-template-columns: 1fr 1fr; gap: 10px; }
    .admin-stat { padding: 14px 12px; }
    .admin-stat .value, .admin-stat-value { font-size: 1.4rem; }

    /* 表格文字不换行，靠 .table-scroll 横滑，保证操作按钮可点 */
    .admin-content th, .admin-content td {
      white-space: nowrap;
      padding: 10px 12px;
    }
    .admin-content { font-size: 13px; }
    /* 表格里的按钮在手机上容易点错，撑到 36px 高 */
    .admin-content .btn-sm, .admin-content .btn { min-height: 36px; padding: 6px 12px; }

    /* 表单：输入框占满一行（16px 字号可避免 iOS 聚焦自动放大） */
    .admin-content input[type="text"],
    .admin-content input[type="url"],
    .admin-content input[type="number"],
    .admin-content input[type="date"],
    .admin-content input[type="datetime-local"],
    .admin-content input[name="q"],
    .admin-content select,
    .admin-content textarea { width: 100% !important; max-width: 100%; font-size: 16px; }

    .admin-content form { max-width: 100%; }

    /* 顶部搜索行：输入框与按钮同排，输入框吃掉剩余宽度，
       避免按钮被挤到下一行（原先 input 固定 240px + 100% 覆盖导致换行） */
    .admin-header form {
      width: 100%;
      display: flex; gap: 8px; flex-wrap: nowrap; align-items: center;
    }
    .admin-header form input[type="text"] { flex: 1 1 auto; width: auto !important; min-width: 0; }
    .admin-header form .btn { flex: 0 0 auto; white-space: nowrap; }
  }

  /* 超窄屏（≤400px）：统计卡单列 */
  @media (max-width: 400px) {
    .admin-stats { grid-template-columns: 1fr; }
  }
</style>
