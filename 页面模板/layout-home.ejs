<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= typeof title !== 'undefined' && title ? title : 'D5ST 校园社区' %><% if (typeof siteTitle !== 'undefined' && title && title !== siteTitle) { %> - <%= siteTitle %><% } %></title>
    <meta name="description" content="D5ST 校园社区 - 连接每一位同学，共享校园生活" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>" />
<!-- ASSETS:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
  <link rel="stylesheet" href="/public/css/bundle-home.ed460ce6a6.css" />
  <!-- ASSETS:END -->
    <%# 关键 CSS 预加载（文件名由构建脚本同步，指纹变化不会失配） %>
    <!-- PRELOAD:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
    <link rel="preload" href="/public/css/bundle-home.ed460ce6a6.css" as="style" />
    <noscript>
      <link rel="stylesheet" href="/public/css/bundle-home.ed460ce6a6.css" />
    </noscript>
    <!-- PRELOAD:END -->
    <script>
      /* 在样式表解析前同步设定主题，避免刷新先闪一下浅色再变深 */
      (function () {
        try {
          var t = localStorage.getItem("leo-theme");
          if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
        <!-- HOME-CSS:BEGIN (由 工具/build-assets.py 生成，勿手改) -->
    <link rel="stylesheet" href="/public/css/layout-home.bc311d67fb.css" />
    <!-- HOME-CSS:END -->
  </head>
  <body>
    <%# 无障碍：Lighthouse 要求文档有唯一 main landmark。
        首页的 3D 首屏 <main class="hero"> 在移动端被 display:none 隐藏，
        隐藏后整页就没有 main 了（屏幕阅读器无法跳转到主内容）。
        因此把 landmark 提到布局层，页面内部改用普通容器。 %>
    <main id="main-content">
    <%- body %>
    </main>

    <script>
      /* 首页弹窗支持：首页使用 layout-home，此前不含弹窗逻辑，
         导致后台配置的「首页弹窗」永远不会显示。这里补齐。 */
      (function () {
        function showPopup(popup) {
          var overlay = document.createElement('div');
          overlay.className = 'popup-overlay';
          var container = document.createElement('div');
          container.className = 'popup-container';
          var closeBtn = document.createElement('button');
          closeBtn.className = 'popup-close-btn';
          closeBtn.innerHTML = '<i class="fas fa-times"></i>';
          var close = function () {
            overlay.classList.remove('show');
            fetch('/api/popups/' + popup.id + '/close', { method: 'POST' }).catch(function () {});
            setTimeout(function () { if (overlay.parentNode) overlay.parentNode.removeChild(overlay); }, 300);
          };
          closeBtn.onclick = close;
          var title = document.createElement('h3');
          title.className = 'popup-title';
          title.textContent = popup.title || '';
          var content = document.createElement('div');
          content.className = 'popup-content';
          // 安全：弹窗正文按纯文本渲染。此前用 innerHTML，后台账号一旦被盗
          // 或被写入 <img onerror=...> 就是全站存储型 XSS。
          content.textContent = popup.content || '';
          var btn = document.createElement('button');
          btn.className = 'popup-btn';
          btn.textContent = '知道了';
          btn.onclick = close;
          container.appendChild(closeBtn);
          container.appendChild(title);
          container.appendChild(content);
          container.appendChild(btn);
          overlay.appendChild(container);
          document.body.appendChild(overlay);
          setTimeout(function () { overlay.classList.add('show'); }, 100);
        }
        async function loadPopups() {
          try {
            var res = await fetch('/api/popups?page=home');
            var popups = await res.json();
            popups.forEach(showPopup);
          } catch (e) { /* ignore */ }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', loadPopups);
        } else {
          loadPopups();
        }
      })();
    </script>

    <%#
      桌面视觉特效脚本按需加载
      ------------------------------------------------------------
      pidanai-liquid.js 有 70KB，但内部第 8 行就是：
        if (matchMedia("(max-width:1024px), (pointer:coarse)").matches) return;
      也就是手机上它会**立刻退出、什么都不做** —— 但前提是浏览器已经
      把这 70KB 下载并解析完了。移动端实测因此多吃 ~1 秒主线程阻塞（TBT）。

      所以改成先用 matchMedia 判断，只在真正会用到特效的宽屏精确指针设备上
      注入脚本。手机上完全不下载 → 省掉下载、解析、执行三重开销。
      no-js 环境下 document.write 退化：脚本不加载，但页面内容本身完整。
    %>
    <script>
      (function () {
        var wantFx = false;
        try {
          wantFx = window.matchMedia('(min-width: 1025px) and (pointer: fine)').matches;
        } catch (e) { wantFx = false; }
        if (!wantFx) return;
        var s = document.createElement('script');
        s.src = '/public/js/pidanai-liquid.js';
        s.defer = true;
        document.head.appendChild(s);
      })();
    </script>
    <%#
      首页脚本二选一
      ------------------------------------------------------------
      home-shell.js 有 585 行 / 25KB，绝大部分是桌面视觉特效
      （自定义光标、光标揭示层、Canvas 线场、FPS 计数器、滚动光标模糊）。
      移动端虽然内部用 liteMode 跳过了逐帧动画，但整个文件仍要下载并解析，
      4x CPU 降速下实测占用约 390ms 主线程 —— 而这些代码手机上一行都不执行。

      所以按设备分两套：
        - 宽屏 + 精确指针（鼠标）→ home-shell.js（完整特效）
        - 其余（手机/平板/触屏）  → home-lite.js（仅保留主题/菜单/渐显/数字滚动）
      两者互斥，不会重复绑定事件。
    %>
    <script>
      (function () {
        var full = false;
        try {
          full = window.matchMedia('(min-width: 1025px) and (pointer: fine)').matches;
        } catch (e) { full = false; }
        var s = document.createElement('script');
        s.src = full ? '/public/js/home-shell.js' : '/public/js/home-lite.js';
        s.defer = true;
        document.head.appendChild(s);
      })();
    </script>
  </body>
</html>
