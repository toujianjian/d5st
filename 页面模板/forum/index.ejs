<style>
  .forum-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 20px 60px; }
  .forum-head {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; flex-wrap: wrap; margin-bottom: 18px;
  }
  .forum-title { font-size: 26px; font-weight: 700; color: var(--text-dark); display: flex; align-items: center; gap: 10px; }
  .forum-title i { color: var(--primary); }
  .forum-desc { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
  .btn-primary-sm {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 18px; border: none; border-radius: 12px; cursor: pointer;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; font-size: 14px; font-weight: 600; text-decoration: none;
    box-shadow: 0 6px 20px rgba(211,47,47,0.3); transition: all .25s ease;
  }
  .btn-primary-sm:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(211,47,47,0.4); }

  /* 版块（圈子） */
  .board-bar { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 10px; margin-bottom: 14px; }
  .board-bar::-webkit-scrollbar { height: 6px; }
  .board-bar::-webkit-scrollbar-thumb { background: rgba(211,47,47,.25); border-radius: 3px; }
  .board-chip {
    flex-shrink: 0; display: flex; align-items: center; gap: 8px;
    padding: 10px 16px; border-radius: 14px; text-decoration: none;
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    color: var(--text-dark); font-size: 14px; font-weight: 500;
    transition: all .25s cubic-bezier(.34,1.56,.64,1);
  }
  .board-chip:hover { transform: translateY(-2px); border-color: var(--primary-light); }
  .board-chip.active {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff; border-color: transparent; box-shadow: 0 6px 18px rgba(211,47,47,.35);
  }
  .board-chip .cnt { font-size: 12px; opacity: .75; }

  /* 排序 */
  .sort-bar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
  .sort-tab {
    padding: 7px 14px; border-radius: 10px; font-size: 13px; text-decoration: none;
    background: rgba(255,255,255,.6); border: 1px solid rgba(211,47,47,.15);
    color: var(--text-light); transition: all .2s ease;
  }
  .sort-tab:hover { border-color: var(--primary-light); color: var(--primary); }
  .sort-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

  .forum-layout { display: grid; grid-template-columns: 1fr 280px; gap: 20px; align-items: start; }
  @media (max-width: 900px) { .forum-layout { grid-template-columns: 1fr; } }

  /* 帖子卡片 */
  .post-list { display: flex; flex-direction: column; gap: 12px; }
  .post-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 18px; padding: 18px 20px;
    box-shadow: var(--shadow-soft); transition: all .3s cubic-bezier(.34,1.56,.64,1);
    display: flex; gap: 14px; text-decoration: none; color: inherit;
  }
  .post-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); border-color: var(--primary-light); }
  .post-cover {
    width: 96px; height: 72px; border-radius: 12px; object-fit: cover; flex-shrink: 0;
    background: linear-gradient(135deg, #ffe4e4, #ffd0d0);
  }
  .post-main { flex: 1; min-width: 0; }
  .post-title-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .post-title { font-size: 16px; font-weight: 600; color: var(--text-dark); }
  .badge {
    font-size: 11px; padding: 2px 8px; border-radius: 8px; font-weight: 600; flex-shrink: 0;
  }
  .badge-top { background: linear-gradient(135deg,#ff6b35,#d32f2f); color: #fff; }
  .badge-essence { background: linear-gradient(135deg,#ffd700,#ff9800); color: #6b4e00; }
  .badge-type { background: rgba(211,47,47,.1); color: var(--primary); }
  .badge-cat { background: rgba(0,0,0,.05); color: var(--text-muted); }
  .post-excerpt {
    font-size: 14px; color: var(--text-light); line-height: 1.6; margin-bottom: 8px;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-meta { display: flex; align-items: center; gap: 14px; font-size: 12px; color: var(--text-muted); flex-wrap: wrap; }
  .post-meta span { display: flex; align-items: center; gap: 4px; }
  .post-tag {
    display: inline-block; padding: 2px 8px; margin-right: 6px; border-radius: 8px;
    background: rgba(211,47,47,.08); color: var(--primary); font-size: 11px; text-decoration: none;
  }

  /* 侧栏卡片 */
  .side-card {
    background: var(--glass-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border-radius: 18px; padding: 18px; margin-bottom: 14px; box-shadow: var(--shadow-soft);
  }
  .side-title { font-size: 14px; font-weight: 700; color: var(--text-dark); margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }
  .side-title i { color: var(--primary); }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag-cloud a {
    padding: 4px 10px; border-radius: 10px; font-size: 12px; text-decoration: none;
    background: rgba(211,47,47,.08); color: var(--primary); transition: all .2s;
  }
  .tag-cloud a:hover { background: var(--primary); color: #fff; }
  .side-empty { font-size: 13px; color: var(--text-muted); line-height: 1.6; }
  .user-row { display: flex; align-items: center; gap: 10px; padding: 7px 0; }
  .user-row .av {
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 14px;
  }
  .user-row .nm { font-size: 13px; color: var(--text-dark); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .user-row .pc { font-size: 12px; color: var(--text-muted); }
  .checkin-btn {
    width: 100%; padding: 11px; border: none; border-radius: 12px; cursor: pointer;
    background: linear-gradient(135deg, var(--accent), var(--primary)); color: #fff;
    font-size: 14px; font-weight: 600; transition: all .25s ease;
  }
  .checkin-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(211,47,47,.35); }
  .checkin-btn.done { background: rgba(0,0,0,.08); color: var(--text-muted); cursor: default; }

  .pager { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 22px; flex-wrap: wrap; }
  .pager a, .pager span {
    padding: 8px 14px; border-radius: 10px; font-size: 13px; text-decoration: none;
    background: rgba(255,255,255,.7); border: 1px solid rgba(211,47,47,.15); color: var(--text-light);
  }
  .pager a:hover { border-color: var(--primary); color: var(--primary); }
  .pager .cur { background: var(--primary); color: #fff; border-color: var(--primary); }
  .empty-box { text-align: center; padding: 60px 20px; color: var(--text-muted); }
  .empty-box i { font-size: 48px; opacity: .4; margin-bottom: 14px; }
</style>

<div class="forum-wrap">
  <div class="forum-head">
    <div>
      <div class="forum-title"><i class="fas fa-comments"></i> <%= board ? board.name : '校园贴吧' %></div>
      <div class="forum-desc"><%= board ? (board.description || '版块话题') : '分享校园生活，聊聊学习与成长' %> · 共 <%= total %> 篇话题</div>
    </div>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <a href="/forum/new" class="btn-primary-sm"><i class="fas fa-pen"></i> 发布帖子</a>
    <% } else { %>
    <a href="/login" class="btn-primary-sm"><i class="fas fa-sign-in-alt"></i> 登录后发帖</a>
    <% } %>
  </div>

  <!-- 版块（圈子） -->
  <% if (boards && boards.length > 0) { %>
  <div class="board-bar">
    <a href="/forum" class="board-chip <%= !board ? 'active' : '' %>">🏠 全部</a>
    <% boards.forEach(function(b) { %>
    <a href="/forum?board=<%= b.slug %>" class="board-chip <%= board && board.slug === b.slug ? 'active' : '' %>">
      <span><%= b.icon %></span> <%= b.name %> <span class="cnt"><%= b.post_count || 0 %></span>
    </a>
    <% }); %>
  </div>
  <% } %>

  <div class="sort-bar">
    <% var qs = board ? 'board=' + board.slug + '&' : ''; %>
    <a href="/forum?<%= qs %>sort=newest" class="sort-tab <%= activeSort === 'newest' ? 'active' : '' %>">最新</a>
    <a href="/forum?<%= qs %>sort=hot" class="sort-tab <%= activeSort === 'hot' ? 'active' : '' %>">热门</a>
    <a href="/forum?<%= qs %>sort=essence" class="sort-tab <%= activeSort === 'essence' ? 'active' : '' %>">精华</a>
    <% if (activeTag) { %>
    <span class="sort-tab" style="background:rgba(211,47,47,.12);color:var(--primary);border-color:var(--primary-light);">
      #<%= activeTag %> <a href="/forum" style="color:inherit;text-decoration:none;">×</a>
    </span>
    <% } %>
  </div>

  <div class="forum-layout">
    <div class="post-list">
      <% if (posts && posts.length > 0) { %>
      <% posts.forEach(function(p) { %>
      <a href="/forum/<%= p.id %>" class="post-card">
        <% if (p.cover_image) { %>
        <img class="post-cover" src="<%= p.cover_image %>" alt="" loading="lazy" decoding="async" onerror="this.style.display='none'" />
        <% } %>
        <div class="post-main">
          <div class="post-title-row">
            <% if (p.is_top) { %><span class="badge badge-top">置顶</span><% } %>
            <% if (p.is_hot) { %><span class="badge badge-essence">精华</span><% } %>
            <span class="badge badge-type"><%= p.type_icon %> <%= p.type_label %></span>
            <span class="post-title"><%= p.title %></span>
          </div>
          <div class="post-excerpt"><%= p.content %></div>
          <div class="post-meta">
            <span><i class="fas fa-user"></i> <%= p.author %></span>
            <span><i class="far fa-eye"></i> <%= p.views || 0 %></span>
            <span><i class="far fa-comment"></i> <%= p.comments_count %></span>
            <span><i class="far fa-heart"></i> <%= p.likes %></span>
            <span><i class="far fa-clock"></i> <%= fmtDate(p.created_at) %></span>
            <% if (p.board_name) { %><span class="badge badge-cat"><%= p.board_name %></span><% } %>
          </div>
          <% if (p.tags) { %>
          <div style="margin-top:7px;">
            <% String(p.tags).split(/[,，]/).forEach(function(t) { if (t.trim()) { %>
            <span class="post-tag">#<%= t.trim() %></span>
            <% } }); %>
          </div>
          <% } %>
        </div>
      </a>
      <% }); %>
      <% } else { %>
      <div class="empty-box"><i class="fas fa-inbox"></i><p>还没有帖子，来发第一篇吧</p></div>
      <% } %>

      <% if (totalPages > 1) { %>
      <div class="pager">
        <% if (page > 1) { %><a href="/forum?<%= qs %>page=<%= page - 1 %>">上一页</a><% } %>
        <% for (var i = 1; i <= totalPages; i++) { %>
          <% if (i === page) { %><span class="cur"><%= i %></span><% } else { %>
          <a href="/forum?<%= qs %>page=<%= i %>"><%= i %></a><% } %>
        <% } %>
        <% if (page < totalPages) { %><a href="/forum?<%= qs %>page=<%= page + 1 %>">下一页</a><% } %>
      </div>
      <% } %>
    </div>

    <!-- 侧栏 -->
    <div>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="side-card">
        <div class="side-title"><i class="fas fa-calendar-check"></i> 每日签到</div>
        <button class="checkin-btn <%= checkedIn ? 'done' : '' %>" id="checkinBtn" <%= checkedIn ? 'disabled' : '' %>>
          <%= checkedIn ? '今日已签到 ✓' : '签到 +10 积分' %>
        </button>
      </div>
      <% } %>

      <div class="side-card">
        <div class="side-title"><i class="fas fa-tags"></i> 热门话题</div>
        <% if (popularTags && popularTags.length > 0) { %>
        <div class="tag-cloud">
          <% popularTags.forEach(function(t) { %>
          <a href="/forum?tag=<%= encodeURIComponent(t.name) %>"><%= t.name %> · <%= t.cnt %></a>
          <% }); %>
        </div>
        <% } else { %>
        <div class="side-empty">还没有话题标签，发帖时加上标签就会出现在这里</div>
        <% } %>
      </div>

      <% if (activeUsers && activeUsers.length > 0) { %>
      <div class="side-card">
        <div class="side-title"><i class="fas fa-fire"></i> 活跃用户</div>
        <% activeUsers.forEach(function(u) { %>
        <div class="user-row">
          <div class="av"><%= (u.real_name || u.username || 'U').charAt(0) %></div>
          <div class="nm"><%= u.real_name || u.username %></div>
          <div class="pc"><%= u.post_count %> 帖</div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  var btn = document.getElementById('checkinBtn');
  if (btn) {
    btn.addEventListener('click', async function () {
      if (btn.disabled) return;
      try {
        var r = await fetch('/forum/checkin', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }
        });
        var d = await r.json();
        if (d.success) {
          btn.textContent = '今日已签到 ✓ +' + d.points;
          btn.classList.add('done');
          btn.disabled = true;
        } else if (d.error) {
          alert(d.error);
        }
      } catch (e) { alert('签到失败，请先登录'); }
    });
  }
</script>
