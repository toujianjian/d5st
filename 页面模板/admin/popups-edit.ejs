<div class="admin-layout">
  <%- include('_nav') %>
  <div class="admin-content">
    <div class="card">
      <div class="card-title">✏️ 编辑弹窗 #<%= popup.id %></div>
      <form method="POST" action="/admin/popups/edit/<%= popup.id %>">
        <div class="form-group">
          <label class="form-label">标题</label>
          <input type="text" name="title" class="form-input" value="<%= popup.title %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">内容</label>
          <textarea name="content" class="form-textarea" required><%= popup.content %></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">类型</label>
          <select name="type" class="form-select">
            <option value="info" <%= popup.type === 'info' ? 'selected' : '' %>>信息</option>
            <option value="success" <%= popup.type === 'success' ? 'selected' : '' %>>成功</option>
            <option value="warning" <%= popup.type === 'warning' ? 'selected' : '' %>>警告</option>
            <option value="error" <%= popup.type === 'error' ? 'selected' : '' %>>错误</option>
          </select>
        </div>
        <%
          var currentPages = String(popup.target_pages || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          var knownKeys = pages.map(function (p) { return p.key; });
        %>
        <div class="form-group">
          <label class="form-label">目标页面（可多选）</label>
          <div class="page-checks">
            <% pages.forEach(function (pg) { %>
              <label class="page-check">
                <input type="checkbox" name="target_pages" value="<%= pg.key %>"
                       data-all="<%= pg.key === 'all' ? '1' : '0' %>"
                       <%= currentPages.indexOf(pg.key) > -1 ? 'checked' : '' %>>
                <span><%= pg.label %></span>
              </label>
            <% }); %>
            <%# 兼容历史/自定义取值，避免编辑保存时丢失 %>
            <% currentPages.filter(function (k) { return knownKeys.indexOf(k) === -1; }).forEach(function (k) { %>
              <label class="page-check">
                <input type="checkbox" name="target_pages" value="<%= k %>" checked>
                <span><%= k %>（自定义）</span>
              </label>
            <% }); %>
          </div>
          <div class="form-hint">勾选「全部页面」表示所有页面；一个都不勾按「全部页面」处理。</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">排序</label>
            <input type="number" name="sort_order" class="form-input" value="<%= popup.sort_order %>">
          </div>
          <div class="form-group">
            <label class="form-label" style="display:flex;align-items:center;gap:8px;margin-top:24px;">
              <input type="checkbox" name="show_once" value="1" <%= popup.show_once ? 'checked' : '' %>> 关闭后不再显示
            </label>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" name="is_active" value="1" <%= popup.is_active ? 'checked' : '' %>> 启用
          </label>
        </div>
        <button type="submit" class="btn btn-primary">保存</button>
        <a href="/admin/popups" class="btn btn-ghost" style="margin-left:12px;">取消</a>
      </form>
    </div>
  </div>
</div>

<script>
  /* 「全部页面」与具体页面互斥：选全部则清空其它，选具体则取消全部 */
  (function () {
    var boxes = Array.prototype.slice.call(document.querySelectorAll('input[name="target_pages"]'));
    if (!boxes.length) return;
    var all = boxes.filter(function (b) { return b.dataset.all === '1'; })[0];
    boxes.forEach(function (b) {
      b.addEventListener('change', function () {
        if (b === all && b.checked) {
          boxes.forEach(function (o) { if (o !== all) o.checked = false; });
        } else if (b !== all && b.checked && all) {
          all.checked = false;
        }
      });
    });
  })();
</script>
